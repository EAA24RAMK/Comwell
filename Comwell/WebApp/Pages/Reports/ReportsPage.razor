@page "/rapporter"
@inject IUserService UserService
@inject IStudentPlanService StudentPlanService
@inject ITemplateService TemplateService
@using Core.Models
@using WebApp.Services
@using WebApp.Components.Reports

<div class="dashboard-container">
    <!-- Executive Header -->
    <div class="executive-header">
        <div class="header-content">
            <div class="header-title-section">
                <h1 class="dashboard-title">
                    <i class="bi bi-graph-up-arrow me-3"></i>
                    HR Rapporter & Analyse
                </h1>
                <p class="dashboard-subtitle">Komplet overblik over medarbejderdata, progression og performance</p>
            </div>
            <div class="header-metrics">
                <div class="quick-metric">
                    <div class="metric-value">@filteredUsers.Count()</div>
                    <div class="metric-label">Totale medarbejdere</div>
                </div>
                <div class="quick-metric">
                    <div class="metric-value">@locations.Count</div>
                    <div class="metric-label">Lokationer</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Control Panel -->
    <div class="control-panel">
        <div class="panel-header">
            <h3 class="panel-title">
                <i class="bi bi-sliders me-2"></i>
                Analyse Kontrolpanel
            </h3>
            <div class="panel-actions">
                <button class="btn-export">
                    <i class="bi bi-download me-2"></i>
                    Eksporter Data
                </button>
            </div>
        </div>
        
        <div class="control-grid">
            <div class="control-item">
                <label class="control-label">
                    <i class="bi bi-geo-alt me-2"></i>
                    Filtrér efter lokation
                </label>

                <MultiSelectDropdownComponent 
                    Options="locations" 
                    SelectedItems="SelectedLocations" 
                    SelectedItemsChanged="OnLocationSelectionChanged" />
            </div>
            
            <div class="control-item">
                <label class="control-label">
                    <i class="bi bi-calendar3 me-2"></i>
                    Filtrér efter periode
                </label>
                <SingleSelectDropdownComponent
                    Options="periodOptions"
                    SelectedOption="@selectedPeriod"
                    SelectedOptionChanged="@(value => selectedPeriod = value)" />

            </div>
            
            <div class="control-item">
                <label class="control-label">
                    <i class="bi bi-target me-2"></i>
                    Analyser specifikt mål (kun elever)
                </label>
                <SingleSelectDropdownComponent
                    Options="goalOptions"
                    SelectedOption="@selectedGoalTitle"
                    SelectedOptionChanged="@(value => selectedGoalTitle = value)" />
            </div>
        </div>
    </div>

    <!-- Executive Summary -->
    <div class="summary-section">
        <div class="summary-header">
            <h3 class="summary-title">
                <i class="bi bi-bar-chart-fill me-2"></i>
                Oversigt
            </h3>
        </div>
        
        <div class="summary-grid">
            <!-- Total Summary Card -->
            <div class="summary-card primary">
                <div class="card-header">
                    <div class="card-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div class="card-meta">
                        <h4>Medarbejdere i alt</h4>
                    </div>
                </div>
                <div class="card-value">@filteredUsers.Count()</div>
                <div class="card-footer">
                    <span class="trend positive">
                        <i class="bi bi-arrow-up"></i>
                        Fordelt på @roles.Count roller
                    </span>
                </div>
            </div>

            <!-- Role-specific Cards -->
            @foreach (var role in roles)
            {
                var count = filteredUsers.Count(u => u.Role == role);
                if (count > 0)
                {
                    var percentage = (double)count / filteredUsers.Count() * 100;
                    var roleClass = GetRoleStyleClass(role);
                    
                    <div class="summary-card @roleClass">
                        <div class="card-header">
                            <div class="card-icon">
                                <i class="@GetRoleIcon(role)"></i>
                            </div>
                            <div class="card-meta">
                                <h4>@role</h4>
                                <p>@percentage.ToString("F1")% af total</p>
                            </div>
                        </div>
                        @if (role == "Elev")
                        {
                            <div class="card-value">@filteredStudents.Count</div>
                            var avgCompletion = CalculateAverageCompletion();
                            <div class="card-footer">
                                <div class="progress-indicator">
                                    <div class="progress-bar">
                                        <div class="progress-fill" style="width: @avgCompletion%"></div>
                                    </div>
                                    <span class="progress-text">@avgCompletion% gennemsnitlig fuldførelse</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="card-value">@count</div>
                            <div class="card-footer">
                                <span class="status-indicator active">
                                    <i class="bi bi-check-circle-fill"></i>
                                    Aktive medarbejdere
                                </span>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
    
    <!-- Statistik og Visualisering -->
    <div class="summary-section">
        <div class="summary-header">
            <h3 class="summary-title">
                <i class="bi bi-pie-chart-fill me-2"></i>
                Statistik og visualisering
            </h3>
        </div>

        @if (!string.IsNullOrWhiteSpace(selectedLocation) || 
             !string.IsNullOrWhiteSpace(selectedPeriod) || 
             !string.IsNullOrWhiteSpace(selectedGoalTitle))
        {
            <div class="diagram-filters">
                <span class="filter-title">Filtreret visning:</span>
                @if (SelectedLocations.Any()) {
                    @foreach (var loc in SelectedLocations)
                    {
                        <span class="filter-badge">📍 @loc</span>
                    }
                }
                @if (!string.IsNullOrWhiteSpace(selectedPeriod)) {
                    <span class="filter-badge">📆 @selectedPeriod</span>
                }
                @if (!string.IsNullOrWhiteSpace(selectedGoalTitle)) {
                    <span class="filter-badge">🎯 @selectedGoalTitle</span>
                }
            </div>
        }

        <div class="summary-grid">
            <div class="summary-card chart-card">
                <div class="card-header">
                    <div class="card-icon">
                        <i class="bi bi-pie-chart"></i>
                    </div>
                    <div class="card-meta">
                        <h4>Målstatus fordelt</h4>
                        <p>Viser antal mål pr. status</p>
                    </div>
                </div>

                <div class="card-value">
                    <GoalChartComponent
                        Completed="@GoalsCompleted"
                        InProgress="@GoalsInProgress"
                        Attention="@GoalsNeedsAttention" 
                        NotStarted="@GoalsNotStarted"/>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Analysis Section -->
    <div class="analysis-section">
        <div class="analysis-header">
            <h3 class="analysis-title">
                <i class="bi bi-table me-2"></i>
                Detaljeret Medarbejder Analyse
            </h3>
            <div class="analysis-meta">
                Viser @filteredUsers.Count() medarbejdere
                @if (!string.IsNullOrWhiteSpace(selectedLocation))
                {
                    <span class="filter-badge">📍 @selectedLocation</span>
                }
            </div>
        </div>

        <!-- Data Tables for each Role -->
        @foreach (var role in roles)
        {
            var usersInRole = filteredUsers.Where(u => u.Role == role).ToList();
            if (!usersInRole.Any()) continue;

            <div class="data-section" id="@role">
                <div class="section-header">
                    <div class="section-title-area">
                        <h4 class="section-title">
                            <i class="@GetRoleIcon(role) me-2"></i>
                            @role Medarbejdere
                        </h4>
                        <div class="section-summary">
                            <span class="count-badge">@usersInRole.Count medarbejdere</span>
                            @if (role == "Elev")
                            {
                                var avgCompletion = CalculateRoleAverageCompletion(usersInRole);
                                <span class="completion-badge" style="background: linear-gradient(90deg, #28a745 @avgCompletion%, #e9ecef @avgCompletion%)">
                                    @avgCompletion% fuldført
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="table-container">
                    <table class="professional-table">
                        <thead>
                            <tr>
                                <th class="col-name">
                                    <i class="bi bi-person me-1"></i>
                                    Medarbejder
                                </th>
                                <th class="col-contact">
                                    <i class="bi bi-envelope me-1"></i>
                                    Kontakt
                                </th>
                                <th class="col-location">
                                    <i class="bi bi-geo-alt me-1"></i>
                                    Lokation
                                </th>
                                @if (role == "Elev")
                                {
                                    <th class="col-progress">
                                        <i class="bi bi-graph-up me-1"></i>
                                        Progression
                                    </th>
                                    <th>
                                        <i class="bi bi-calendar2-week me-1"></i>
                                        Aktuel periode
                                    </th>
                                    <th>
                                        <i class="bi bi-check2-square me-1"></i>
                                        Praktik godkendt
                                    </th>
                                    <th>
                                        <i class="bi bi-check2-square me-1"></i>
                                        Skole godkendt
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in usersInRole.OrderBy(u => u.Name))
                            {
                                var userPlans = allPlans.Where(p => p.StudentId == user.Id).ToList();
                                var allGoals = userPlans.SelectMany(p => p.Goals).ToList();
                                var percent = CalculateCompletionPercentage(allGoals, role, selectedGoalTitle);
                                
                                <tr class="data-row">
                                    <td class="col-name">
                                        <div class="employee-info">
                                            <div class="employee-avatar">
                                                @GetInitials(user.Name)
                                            </div>
                                            <div class="employee-details">
                                                <div class="employee-name">@user.Name</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="col-contact">
                                        <div class="contact-info">
                                            <a href="mailto:@user.Email" class="email-link">
                                                <i class="bi bi-envelope me-1"></i>
                                                @user.Email
                                            </a>
                                        </div>
                                    </td>
                                    <td class="col-location">
                                        <div class="location-badge">
                                            <i class="bi bi-building me-1"></i>
                                            @user.Hotel
                                        </div>
                                    </td>
                                    @if (role == "Elev")
                                    {
                                        <td class="col-progress">
                                            <div class="progress-cell">
                                                <div class="progress-visual">
                                                    <div class="progress-bar-detailed">
                                                        <div class="progress-fill-detailed" style="width: @percent%"></div>
                                                    </div>
                                                    <span class="progress-percentage">@percent%</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @GetCurrentPeriod(user.Id)
                                        </td>
                                        <td>
                                            @(IsPracticeApproved(user.Id) ? "✅ Ja" : "❌ Nej")
                                        </td>
                                        <td>
                                            @(IsSchoolApproved(user.Id) ? "✅ Ja" : "❌ Nej")
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<User> allUsers = new();             // Liste over alle brugere (elever, HR, kokke, køkkenchefer)
    private List<StudentPlan> allPlans = new();       // Liste over alle elevplaner i systemet
    private List<Template> allTemplates = new(); // Liste over alle templates

    // Filtre
    private string selectedLocation = "";            // Valgt lokation (hotel) til filtrering
    private string selectedPeriod = "";
    private string selectedGoalTitle = "";

    
    // Hjælpelister
    private List<string> roles = new();               // Liste over unikke roller (Elev, HR, osv.)
    private List<string> locations = new();           // Liste over unikke lokationer (hoteller)
    private List<string> goalTitles = new();          // Liste over unikke mål (goal-titler)

    // Bruges overalt – filtrerer elever på periode, men lader andre roller være
    private List<User> filteredUsers => allUsers.Where(u =>
    {
        // Lokation
        if (SelectedLocations.Any() && !SelectedLocations.Contains(u.Hotel))
            return false;

        if (u.Role == "Elev")
        {
            var plan = allPlans.FirstOrDefault(p => p.StudentId == u.Id);
            var template = allTemplates.FirstOrDefault(t => t.Id == plan?.TemplateId);

            // Praktikperiode filter
            if (!string.IsNullOrWhiteSpace(selectedPeriod) && template?.Title != selectedPeriod)
                return false;

            // Mål-filter (fjerner emoji før sammenligning)
            if (!string.IsNullOrWhiteSpace(selectedGoalTitle) && selectedGoalTitle != "🎯 Alle mål")
            {
                var cleanTitle = selectedGoalTitle.Replace("📋 ", "");
                var hasGoal = plan?.Goals?.Any(g => g.Title == cleanTitle) ?? false;
                if (!hasGoal)
                    return false;
            }
        }

        return true;
    }).ToList();

    
    // Bruges til gennemsnitsprogression i elevkortet
    private List<User> filteredStudents => filteredUsers.Where(u => u.Role == "Elev").ToList();
    
    private List<StudentPlan> FilteredStudentPlans => allPlans
        .Where(plan => filteredStudents.Any(s => s.Id == plan.StudentId))
        .ToList();

    // Initialisering ved sideindlæsning
    protected override async Task OnInitializedAsync()
    {
        allUsers = await UserService.GetAllUsersAsync();
        allPlans = await StudentPlanService.GetAllPlansAsync();
        allTemplates = await TemplateService.GetAllTemplatesAsync();

        // Find unikke roller, sorter så "Elev" står først
        roles = allUsers
            .Select(u => u.Role)
            .Distinct()
            .OrderByDescending(r => r == "Elev")
            .ToList();
        
        // Find unikke lokationer (hoteller), sorteret alfabetisk
        locations = allUsers
            .Select(u => u.Hotel)
            .Where(h => !string
                .IsNullOrWhiteSpace(h))
            .Distinct()
            .OrderBy(h => h)
            .ToList();
        
        // Find unikke måltitler fra alle elevplaner, sorteret alfabetisk
        goalTitles = allPlans
            .SelectMany(p => p.Goals)
            .Select(g => g.Title)
            .Distinct()
            .OrderBy(t => t)
            .ToList();
    }
    
    // Beregner fuldførelsesprocent for en bruger baseret på deres mål (goals)
    private int CalculateCompletionPercentage(List<Goal> goals, string role, string goalTitle)
    {
        if (role != "Elev") return 0;
        
        // Hvis intet specifikt mål (goalTitle) er valgt
        if (string.IsNullOrWhiteSpace(goalTitle))
        {
            // Beregn procent: (Antal fuldførte mål / Total mål) * 100
            int total = goals.Count;
            int done = goals.Count(g => g.Subtasks.All(s => s.Status == "Fuldført"));
            return total > 0 ? (int)Math.Round(done * 100.0 / total) : 0;
        }
        // Hvis et specifikt mål er valgt
        else
        {
            var selectedGoals = goals.Where(g => g.Title == goalTitle).ToList();
            int total = selectedGoals.Count;
            int done = selectedGoals.Count(g => g.Subtasks.All(s => s.Status == "Fuldført"));
            
            return total > 0 ? (int)Math.Round(done * 100.0 / total) : 0;
        }
    }

    // Helper methods for professional styling
    private string GetRoleStyleClass(string role)
    {
        return role switch
        {
            "Elev" => "student",
            "HR" => "hr",
            "Køkkenchef" => "chef",
            "Kok" => "cook",
            _ => "default"
        };
    }

    private string GetRoleIcon(string role)
    {
        return role switch
        {
            "Elev" => "bi-mortarboard-fill",
            "HR" => "bi-person-badge-fill",
            "Køkkenchef" => "bi-award-fill",
            "Kok" => "bi-egg-fried",
            _ => "bi-person-fill"
        };
    }

    private int CalculateAverageCompletion()
    {
        if (!filteredStudents.Any()) return 0;

        var completions = filteredStudents.Select(student =>
        {
            var userPlans = allPlans.Where(p => p.StudentId == student.Id).ToList();
            var allGoals = userPlans.SelectMany(p => p.Goals).ToList();
            return CalculateCompletionPercentage(allGoals, "Elev", selectedGoalTitle);
        }).ToList();

        return completions.Any() ? (int)completions.Average() : 0;
    }

    private int CalculateRoleAverageCompletion(List<User> usersInRole)
    {
        if (usersInRole.First().Role != "Elev") return 0;

        var completions = usersInRole.Select(student =>
        {
            var userPlans = allPlans.Where(p => p.StudentId == student.Id).ToList();
            var allGoals = userPlans.SelectMany(p => p.Goals).ToList();
            return CalculateCompletionPercentage(allGoals, "Elev", selectedGoalTitle);
        }).ToList();

        return completions.Any() ? (int)completions.Average() : 0;
    }

    private static string GetInitials(string fullName)
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "",
            1 => parts[0][..1].ToUpper(),
            _ => $"{parts[0][..1]}{parts[^1][..1]}".ToUpper()
        };
    }
    
    private string GetCurrentPeriod(int studentId)
    {
        var plan = allPlans.FirstOrDefault(p => p.StudentId == studentId);
        if (plan == null) return "Ingen plan";

        var template = allTemplates.FirstOrDefault(t => t.Id == plan.TemplateId);
        return template?.Title ?? "Ingen praktikperiode";
    }
    
    private bool IsPracticeApproved(int studentId)
    {
        var plan = allPlans.FirstOrDefault(p => p.StudentId == studentId);
        return plan?.IsApprovedByChef ?? false;
    }

    private bool IsSchoolApproved(int studentId)
    {
        var plan = allPlans.FirstOrDefault(p => p.StudentId == studentId);
        return plan?.SchoolPeriods.Any(sp => sp.IsApproved) ?? false;
    }
    
    private List<Goal> GetFilteredGoals()
    {
        var goals = new List<Goal>();

        foreach (var plan in FilteredStudentPlans)
        {
            if (plan.Goals == null) continue;

            foreach (var goal in plan.Goals)
            {
                if (!string.IsNullOrWhiteSpace(selectedGoalTitle) && goal.Title != selectedGoalTitle)
                    continue;

                goals.Add(goal);
            }
        }

        return goals;
    }

    private int GoalsCompleted => GetFilteredGoals().Count(g =>
        g.Subtasks.All(s => s.Status == "Fuldført"));

    private int GoalsNotStarted => GetFilteredGoals().Count(g =>
        g.Subtasks.All(s => s.Status == "Ikke startet"));

    private int GoalsNeedsAttention => GetFilteredGoals().Count(g =>
        g.Subtasks.Any(s => s.Status == "I gang" || s.Status == "Fuldført") &&
        !g.Subtasks.All(s => s.Status == "Fuldført") &&
        g.Deadline != default &&
        (g.Deadline - DateTime.Now).TotalDays <= 5);

    private int GoalsInProgress => GetFilteredGoals().Count(g =>
        g.Subtasks.Any(s => s.Status == "I gang" || s.Status == "Fuldført") &&
        !g.Subtasks.All(s => s.Status == "Fuldført") &&
        !(g.Deadline != default && (g.Deadline - DateTime.Now).TotalDays <= 5));
   
    private List<string> SelectedLocations = new();
    
    private void OnLocationSelectionChanged(List<string> newSelection)
    {
        Console.WriteLine("Ny lokation valgt: " + string.Join(", ", newSelection));
        SelectedLocations = newSelection;
        StateHasChanged();
    }

    private List<string> periodOptions = new()
    {
        "Alle perioder",
        "1. praktikperiode",
        "2. praktikperiode",
        "3. praktikperiode",
        "Afslutning"
    };
    
    private List<string> goalOptions =>
        allPlans
            .Where(p =>
                allUsers.Any(u => u.Id == p.StudentId && u.Role == "Elev") &&
                (string.IsNullOrWhiteSpace(selectedPeriod) ||
                 allTemplates.FirstOrDefault(t => t.Id == p.TemplateId)?.Title == selectedPeriod))
            .SelectMany(p => p.Goals)
            .Select(g => g.Title)
            .Distinct()
            .OrderBy(t => t)
            .Select(t => "📋 " + t)
            .Prepend("🎯 Alle mål")
            .ToList();
} 
