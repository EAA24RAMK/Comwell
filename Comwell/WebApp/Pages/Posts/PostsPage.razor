@page "/posts"
@using WebApp.Services
@using Core.Models
@inject IUserService UserService
@inject IPostService PostService
@attribute [Authorize]


    <div class="dashboard-container">
        <!-- Page Header -->
        <div class="page-header">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="bi bi-chat-square-text-fill me-3"></i>
                    Opslagstavle
                </h1>
                <p class="page-description">Del nyheder, opdateringer og vigtige beskeder med teamet</p>
            </div>
            
            <div class="page-actions">
                <button class="btn-create" @onclick="() => showModal = true">
                    <i class="bi bi-plus-circle me-2"></i>
                    Opret opslag
                </button>
            </div>
        </div>

        <!-- Stats Section -->
        <div class="stats-grid">
            <div class="stat-card posts">
                <div class="stat-icon">
                    <i class="bi bi-chat-square-fill"></i>
                </div>
                <div class="stat-info">
                    <div class="stat-number">@posts.Count</div>
                    <div class="stat-label">Samlede opslag</div>
                </div>
            </div>
            
            <div class="stat-card my-posts">
                <div class="stat-icon">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div class="stat-info">
                    <div class="stat-number">@posts.Count(p => p.Author == currentUser?.Name)</div>
                    <div class="stat-label">Mine opslag</div>
                </div>
            </div>
            
            <div class="stat-card with-links">
                <div class="stat-icon">
                    <i class="bi bi-link-45deg"></i>
                </div>
                <div class="stat-info">
                    <div class="stat-number">@posts.Count(p => !string.IsNullOrWhiteSpace(p.Url))</div>
                    <div class="stat-label">Med links</div>
                </div>
            </div>
            
            <div class="stat-card recent">
                <div class="stat-icon">
                    <i class="bi bi-clock-fill"></i>
                </div>
                <div class="stat-info">
                    <div class="stat-number">@posts.Count(p => p.CreatedAt >= DateTime.Today)</div>
                    <div class="stat-label">I dag</div>
                </div>
            </div>
        </div>

        <!-- Filters Section -->
        <div class="filters-section">
            <div class="filters-header">
                <h3 class="filters-title">
                    <i class="bi bi-search me-2"></i>
                    Søg i opslag
                </h3>
            </div>
            <div class="filters-content">
                <div class="filter-group">
                    <label class="filter-label">
                        <i class="bi bi-search me-1"></i>
                        Søg efter titel eller indhold
                    </label>
                    <input @bind="searchTerm" @bind:event="oninput" 
                           placeholder="Skriv for at søge..." 
                           class="filter-select" />
                </div>
            </div>
        </div>

        <!-- Content Section -->
        <div class="content-section">
            <div class="section-header">
                <h3 class="section-title">
                    <i class="bi bi-collection-fill me-2"></i>
                    Alle opslag
                </h3>
                <div class="section-meta">
                    @{
                        var filteredCount = FilteredPosts().Count();
                    }
                    @if (filteredCount != posts.Count)
                    {
                        <span class="filtered-count">Viser @filteredCount af @posts.Count opslag</span>
                    }
                    else
                    {
                        <span class="total-count">@posts.Count opslag</span>
                    }
                </div>
            </div>

            @if (FilteredPosts().Any())
            {
                <div class="materials-grid">
                    @foreach (var post in FilteredPosts().OrderByDescending(p => p.Id))
                    {
                        <div class="material-card">
                            <div class="material-header">
                                <div class="material-type-icon">
                                    <i class="bi bi-chat-square-text-fill"></i>
                                </div>
                                <div class="material-info">
                                    <h5 class="material-title">@post.Title</h5>
                                    <div class="material-metadata">
                                        <span class="material-subtask">
                                            <i class="bi bi-person me-1"></i>
                                            @post.Author
                                        </span>
                                        <span class="material-date">
                                            <i class="bi bi-clock me-1"></i>
                                            @post.CreatedAt.ToString("dd MMM yyyy HH:mm")
                                        </span>
                                        
                                        <!-- Viser målgruppe hvis bruger er HR eller Køkkenchef -->
                                        @if (currentUser?.Role == "HR" || currentUser?.Role == "Køkkenchef")
                                        {
                                            @if (post.TargetUserIds.Count == 0 || post.TargetUserIds.Count == allUsers.Count)
                                            {
                                                <span class="material-subtask">
                                                    <i class="bi bi-globe me-1"></i>
                                                    Synlig for alle
                                                </span>
                                            }
                                            else
                                            {
                                                var targetNames = allUsers
                                                    .Where(u => post.TargetUserIds.Contains(u.Id))
                                                    .Select(u => u.Name)
                                                    .ToList();

                                                <span class="material-subtask">
                                                    <i class="bi bi-people me-1"></i>
                                                    @(targetNames.Count == 1 ? targetNames[0] : $"{targetNames.Count} personer")
                                                </span>
                                            }
                                        }
                                    </div>
                                </div>
                                
                                <!-- Mulighed for at slette opslag hvis man må -->
                                @if (CanDeletePost(post))
                                {
                                    <div class="material-actions">
                                        <div class="dropdown">
                                            <button class="btn-action" type="button" data-bs-toggle="dropdown">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <button class="dropdown-item text-danger" @onclick="() => ConfirmDelete(post.Id)">
                                                        <i class="bi bi-trash me-2"></i>
                                                        Slet opslag
                                                    </button>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                }
                            </div>
                            
                            <!-- Opslagets indhold -->
                            <div class="material-content">
                                <div class="post-text">@post.Content</div>
                                
                                @if (!string.IsNullOrWhiteSpace(post.Url))
                                {
                                    <div class="material-link">
                                        <i class="bi bi-link-45deg me-2"></i>
                                        <a href="@post.Url" target="_blank" class="link-url">@post.Url</a>
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(post.Url))
                            {
                                <div class="material-footer">
                                    <a href="@post.Url" target="_blank" class="btn-access">
                                        <i class="bi bi-box-arrow-up-right me-2"></i>
                                        Åbn link
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="bi bi-chat-square-x"></i>
                    </div>
                    <h4>Ingen opslag fundet</h4>
                    <p>Der er ingen opslag der matcher din søgning.</p>
                    <button class="btn-create" @onclick="() => showModal = true">
                        <i class="bi bi-plus-circle me-2"></i>
                        Opret første opslag
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Modal til oprettelse af nyt opslag -->
    @if (showModal)
    {
        <div class="modal-backdrop" @onclick="CloseModal"></div>
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-plus-circle me-2"></i>
                            Opret nyt opslag
                        </h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-type me-2"></i>
                                Titel
                            </label>
                            <input @bind="newPost.Title" placeholder="Hvad handler dit opslag om?" class="form-control" />
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-chat-text me-2"></i>
                                Indhold
                            </label>
                            <textarea @bind="newPost.Content" placeholder="Skriv dit opslag her..." rows="4" class="form-control"></textarea>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-link-45deg me-2"></i>
                                Link (valgfrit)
                            </label>
                            <input @bind="newPost.Url" placeholder="https://..." class="form-control" />
                        </div>

                        <!-- Kun HR og Køkkenchef kan vælge modtagere -->
                        @if (currentUser?.Role == "HR" || currentUser?.Role == "Køkkenchef")
                        {
                            <div class="form-group">
                                <label class="form-label">
                                    <i class="bi bi-people me-2"></i>
                                    Målgruppe
                                </label>
                                
                                <div class="target-selection">
                                    <div class="target-buttons">
                                        <button type="button" class="target-btn @(selectedTargetGroup == "All" ? "active" : "")" @onclick="ToggleAllUsers">
                                            <i class="bi bi-globe me-2"></i>
                                            @(selectedTargetGroup == "All" ? "Alle valgt" : "Vælg alle personer")
                                        </button>
                                        <button type="button" class="target-btn @(selectedTargetGroup == "Elev" ? "active" : "")" @onclick='() => ToggleRoleSelection("Elev")'>
                                            <i class="bi bi-mortarboard me-2"></i>
                                            @(selectedTargetGroup == "Elev" ? "Elever valgt" : "Vælg alle elever")
                                        </button>
                                        <button type="button" class="target-btn @(selectedTargetGroup == "Køkkenchef" ? "active" : "")" @onclick='() => ToggleRoleSelection("Køkkenchef")'>
                                            <i class="bi bi-award me-2"></i>
                                            @(selectedTargetGroup == "Køkkenchef" ? "Køkkenchefer valgt" : "Vælg køkkenchefer")
                                        </button>
                                    </div>

                                    <!-- Dropdown for hoteller -->
                                    @if (!selectedAllUsers)
                                    {
                                        <div class="hotel-selection">
                                            <select @onchange="OnHotelChanged" class="form-select">
                                                <option value="">Vælg hotel for specifik målretning</option>
                                                @foreach (var hotel in allHotels)
                                                {
                                                    <option value="@hotel">@hotel</option>
                                                }
                                            </select>
                                        </div>
                                    }

                                    <!-- Checkbox-liste over brugere hvis der ikke vælges alle -->
                                    @if (!selectedAllUsers && filteredUsers.Any())
                                    {
                                        <div class="user-selection">
                                            <label class="selection-label">Vælg specifikke modtagere:</label>
                                            <div class="user-checkboxes">
                                                @foreach (var user in filteredUsers)
                                                {
                                                    <div class="user-checkbox-item">
                                                        <input type="checkbox"
                                                               id="user-@user.Id"
                                                               @onchange="@((ChangeEventArgs e) => ToggleUserSelection(user.Id, (bool)e.Value))"
                                                               checked="@selectedUserIds.Contains(user.Id)" />
                                                        <label for="user-@user.Id" class="user-label">
                                                            <div class="user-info">
                                                                <span class="user-name">@user.Name</span>
                                                                <span class="user-role">@user.Role</span>
                                                            </div>
                                                        </label>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-secondary" @onclick="CloseModal">Annuller</button>
                        <button type="button" class="btn-primary" @onclick="SubmitModal">
                            <i class="bi bi-send me-2"></i>
                            Publicer opslag
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

@code {
    // Bruger- og opslag-relateret data
    private List<Post> posts = new();                      // Liste over alle opslag
    private Post newPost = new();                          // Midlertidigt objekt til oprettelse af nyt opslag
    private User? currentUser;                             // Aktuelt loggede bruger
    private List<User> allUsers = new();                   // Liste over alle brugere
    private List<string> allHotels = new();                // Liste over alle hoteller
    private List<User> filteredUsers = new();              // Liste over filtrerede brugere baseret på valg

// Søge- og filtertilstand
    private List<int> selectedUserIds = new();             // Liste over ID'er på valgte modtagere
    private string searchTerm = "";                        // Søgefelt til søgning i opslag
    private string selectedHotel = "";                     // Valgt hotel til filtrering af brugere
    private string selectedTargetGroup = "";               // Valgt målgruppe (fx "Elev", "Køkkenchef", "All")
    private bool selectedAllUsers = false;                 // Om alle brugere er valgt som modtagere

// UI-tilstand
    private bool showModal = false;                        // Om modal til oprettelse af opslag vises
    private int? confirmDeletePostId = null;               // ID på opslag der er valgt til sletning

    // Formål: Initialiserer siden.
    // Henter aktuel bruger, alle brugere, hoteller og opslag.
    protected override async Task OnInitializedAsync()
    {
        currentUser = await UserService.GetCurrentUserAsync();
        allUsers = await UserService.GetAllUsersAsync();
        allHotels = allUsers
            .Where(u => !string.IsNullOrWhiteSpace(u.Hotel))
            .Select(u => u.Hotel)
            .Distinct()
            .ToList();
        await LoadPosts();
    }

    // Formål: Henter opslag målrettet brugeren fra backend.
    private async Task LoadPosts()
    {
        if (currentUser == null) return;
        posts = await PostService.GetPostsForUserAsync(currentUser.Email, currentUser.Role);
    }

    // Returnerer: Filtrerede opslag baseret på søgning og synlighed.
    // Formål: Filtrerer opslag baseret på om brugeren har adgang til at se opslaget
    private IEnumerable<Post> FilteredPosts()
    {
        var filteredPosts = posts.Where(CanViewPost); // Vis alle opslag til HR og Køkkenchefer
        
        if (string.IsNullOrWhiteSpace(searchTerm))  // Hvis der ikke er søgt efter noget, returner alle synlige opslag
            return filteredPosts;

        // Filtrer opslag baseret på søgning i titel og indhold
        return filteredPosts.Where(post =>
            // Søg i titlen (hvis den ikke er tom)
            (!string.IsNullOrEmpty(post.Title) && 
             post.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            ||
            // Søg i indholdet (hvis det ikke er tomt)
            (!string.IsNullOrEmpty(post.Content) && 
             post.Content.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        );
    }

    // Returnerer: True hvis brugeren må se opslaget, ellers false.
    // Parametre: post – Det opslag der tjekkes.
    // Formål: Bestemmer om opslaget er synligt for den aktuelle bruger.
    private bool CanViewPost(Post post)
    {
        if (currentUser?.Role == "HR" || currentUser?.Role == "Køkkenchef")
            return true;
        return post.TargetUserIds.Count == 0 || post.TargetUserIds.Contains(currentUser?.Id ?? -1);
    }

    // Returnerer: True hvis brugeren må slette opslaget, ellers false.
    // Parametre: post – Det opslag der tjekkes.
    // Formål: Bestemmer om brugeren må slette et opslag.
    private bool CanDeletePost(Post post)
    {
        if (currentUser == null) return false;
        if (currentUser.Role == "Elev")
            return post.Author == currentUser.Name;
        return true;
    }

    // Formål: Sender nyt opslag til backend og nulstiller modalens inputfelter.
    private async Task SubmitModal()
    {
        newPost.Author = currentUser?.Name ?? "Ukendt";
        newPost.CreatedAt = DateTime.Now;
        newPost.TargetUserIds = selectedUserIds;                            // Sæt målgruppe

        var createdPost = await PostService.CreatePostAsync(newPost);       // Opret opslag
        posts.Insert(0, createdPost);                                  // Tilføj til liste
        newPost = new();                                               // Nulstil felter
        selectedUserIds.Clear();
        selectedHotel = "";
        filteredUsers.Clear();
        selectedAllUsers = false;
        selectedTargetGroup = "";
        showModal = false;
        
        await LoadPosts();
        StateHasChanged();
    }

    // Formål: Lukker modal-vinduet til oprettelse af opslag.
    private void CloseModal() => showModal = false;

    // Parametre: id – ID på opslag der skal slettes.
    // Formål: Sletter et opslag og opdaterer visningen.
    private async Task ConfirmDelete(int id)
    {
        await PostService.DeletePostAsync(id);
        confirmDeletePostId = null;
        await LoadPosts();
    }

    // Parametre: postId – ID på opslag der skal åbne/lukke slet-popup.
    // Formål: Åbner eller lukker bekræftelses-popup for sletning.
    private void ToggleDeletePopup(int postId)
    {
        confirmDeletePostId = confirmDeletePostId == postId ? null : postId;
    }
    
    // Parametre: e – Ændringsevent fra hotel-dropdown.
    // Formål: Filtrerer brugere baseret på valgt hotel.
    private void OnHotelChanged(ChangeEventArgs e)
    {
        selectedHotel = e.Value?.ToString() ?? "";
        filteredUsers = allUsers.Where(u => u.Hotel == selectedHotel).ToList();
        selectedUserIds = filteredUsers.Select(u => u.Id).ToList();
        selectedAllUsers = false;
        selectedTargetGroup = "";
    }

    // Parametre: userId – ID på brugeren, isChecked – Om checkbox er valgt.
    // Formål: Tilføjer eller fjerner bruger som skal se opslaget.
    // Bruges i forbindelse med OnHotalChanged
    private void ToggleUserSelection(int userId, bool isChecked)
    {
        if (isChecked && !selectedUserIds.Contains(userId))
            selectedUserIds.Add(userId);
        else if (!isChecked)
            selectedUserIds.Remove(userId);
    }

    // Formål: Vælger eller fjerner alle brugere som modtagere.
    private void ToggleAllUsers()
    {
        if (selectedTargetGroup == "All")
        {
            selectedAllUsers = false;
            selectedTargetGroup = "";
            selectedUserIds.Clear();
        }
        else
        {
            selectedUserIds = allUsers.Select(u => u.Id).ToList();
            selectedAllUsers = true;
            selectedTargetGroup = "All";
        }
        selectedHotel = "";
        filteredUsers = new();
    }

    // Parametre: role – Den rolle brugerne skal filtreres på (fx "Elev").
    // Formål: Vælger alle brugere med en bestemt rolle som modtagere.
    private void ToggleRoleSelection(string role)
    {
        if (selectedTargetGroup == role)
        {
            selectedUserIds.Clear();
            selectedTargetGroup = "";
            selectedAllUsers = false;
        }
        else
        {
            selectedUserIds = allUsers
                .Where(u => u.Role.Equals(role, StringComparison.OrdinalIgnoreCase))
                .Select(u => u.Id)
                .ToList();
            selectedTargetGroup = role;
            selectedAllUsers = true;
        }
        selectedHotel = "";
        filteredUsers = new();
    }
    
    // Formål: Returnerer initialer ud fra brugerens fulde navn.
    // Funktion:
    // - Splitter navnet op ved mellemrum.
    // - Hvis der er flere navne, bruges første bogstav i begge navne.
    // - Hvis kun ét navn, bruges første bogstav.
    private static string GetInitials(string fullName)
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "",
            1 => parts[0][..1].ToUpper(),
            _ => $"{parts[0][..1]}{parts[^1][..1]}".ToUpper()
        };
    }
}
