@page "/users"
@using Core.Models
@using WebApp.Services
@inject IUserService UserService
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = "HR,Køkkenchef,Kok")]

<!-- Modern Users Dashboard -->
<div class="dashboard-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-title-section">
            <h1 class="page-title">
                <i class="bi bi-people me-3"></i>
                Brugere
            </h1>
            <p class="page-description">Her er et samlet overblik over alle brugere i systemet.</p>
        </div>
        
        @if (currentUser?.Role == "HR")
        {
            <div class="page-actions">
                <button class="btn-create" @onclick="CreateUser">
                    <i class="bi bi-person-plus me-2"></i>
                    Tilføj bruger
                </button>
            </div>
        }
    </div>

    <!-- Stats Section -->
    <div class="stats-grid">
        
        @foreach (var role in Roles)
        {
            var count = users.Count(u => u.Role == role);
            if (count > 0)
            {
                <div class="stat-card @GetRoleClass(role)">
                    <div class="stat-icon">
                        <i class="@GetRoleIcon(role)"></i>
                    </div>
                    <div class="stat-info">
                        <div class="stat-number">@count</div>
                        <div class="stat-label">@role</div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Filters Section -->
    <div class="filters-section">
        <div class="filters-header">
            <h3 class="filters-title">
                <i class="bi bi-funnel me-2"></i>
                Filtrér brugere
            </h3>
        </div>
        <div class="filters-content">
            <div class="filter-group">
                <label class="filter-label">
                    <i class="bi bi-search me-1"></i>
                    Søg efter bruger
                </label>
                <input type="text" @bind="searchTerm" @bind:event="oninput" 
                       placeholder="Skriv navn for at søge..." class="filter-select"/>
            </div>
            
            <div class="filter-group">
                <label class="filter-label">
                    <i class="bi bi-person-badge me-1"></i>
                    Rolle
                </label>
                <select @bind="selectedRole" class="filter-select">
                    <option value="">Alle roller</option>
                    @foreach (var role in Roles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </div>
            
            <div class="filter-group">
                <label class="filter-label">
                    <i class="bi bi-geo-alt me-1"></i>
                    Lokation
                </label>
                <select @bind="selectedHotel" class="filter-select">
                    <option value="">Alle lokationer</option>
                    @foreach (var hotel in hotels)
                    {
                        <option value="@hotel">@hotel</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- Content Section -->
    <div class="content-section">
        <div class="section-header">
            <h3 class="section-title">
                <i class="bi bi-people me-2"></i>
                Brugere
            </h3>
        </div>

        @if (FilteredUsers?.Any() != true)
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-person-x"></i>
                </div>
                <h4>Ingen brugere fundet</h4>
                <p>Ingen brugere matcher de valgte filtre.</p>
            </div>
        }
        else
        {
            <div class="materials-grid">
                @foreach (var user in FilteredUsers)
                {
                    <div class="material-card">
                        <!-- User Header -->
                        <div class="material-header">
                            <div class="material-type-icon">
                                <i class="@GetRoleIcon(user.Role)"></i>
                            </div>
                            <div class="material-info">
                                <h5 class="material-title">@user.Name</h5>
                                <div class="material-metadata">
                                    <span class="material-subtask">
                                        <i class="bi bi-person-badge me-1"></i>
                                        @user.Role
                                    </span>
                                    <span class="material-date">
                                        <i class="bi bi-envelope me-1"></i>
                                        @user.Email
                                    </span>
                                </div>
                            </div>
                            
                            @if (currentUser?.Role == "HR")
                            {
                                <div class="material-actions">
                                    <div class="dropdown">
                                        <button class="btn-action" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <button class="dropdown-item" @onclick="() => ToggleUserStatusAsync(user)">
                                                    <i class="bi bi-@(user.Status == "Aktiv" ? "pause-circle" : "play-circle") me-2"></i>
                                                    @(user.Status == "Aktiv" ? "Gør inaktiv" : "Gør aktiv")
                                                </button>
                                            </li>
                                            <li>
                                                <button class="dropdown-item text-danger" @onclick="() => DeleteUserAsync(user.Id)">
                                                    <i class="bi bi-trash me-2"></i>
                                                    Slet
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- User Meta Information -->
                        <div class="material-content">
                            @if (!string.IsNullOrWhiteSpace(user.Hotel))
                            {
                                <div class="material-link">
                                    <i class="bi bi-building me-2"></i>
                                    <span class="link-url">@user.Hotel</span>
                                </div>
                            }
                            
                            @if (!string.IsNullOrWhiteSpace(user.SchoolType))
                            {
                                <div class="material-link">
                                    <i class="bi bi-mortarboard me-2"></i>
                                    <span class="link-url">@user.SchoolType</span>
                                </div>
                            }
                        </div>

                        <!-- User Status -->
                        <div class="material-footer">
                            <div class="user-status @(user.Status == "Aktiv" ? "active" : "inactive")">
                                <i class="bi bi-@(user.Status == "Aktiv" ? "check-circle-fill" : "pause-circle-fill") me-2"></i>
                                @user.Status
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Modal for Opret Bruger -->
@if (showCreateModal)
{
    <div class="modal-overlay" @onclick="CloseCreateModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h4 class="modal-title">
                    <i class="bi bi-person-plus"></i>
                    Opret ny bruger
                </h4>
                <button class="modal-close" @onclick="CloseCreateModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                        @errorMessage
                    </div>
                }

                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">
                            <i class="bi bi-person"></i>
                            Navn
                        </label>
                        <input @bind="newUser.Name" placeholder="Fulde navn" class="form-input" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="bi bi-envelope"></i>
                            Email
                        </label>
                        <input @bind="newUser.Email" placeholder="email@eksempel.dk" type="email" class="form-input" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="bi bi-key"></i>
                            Adgangskode
                        </label>
                        <input @bind="newUser.Password" placeholder="Indtast adgangskode" type="password" class="form-input" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="bi bi-building"></i>
                            Hotel/Lokation
                        </label>
                        <input @bind="newUser.Hotel" placeholder="Hotel navn" class="form-input" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="bi bi-person-badge"></i>
                            Rolle
                        </label>
                        <select @bind="newUser.Role" class="form-select">
                            <option value="" disabled selected>Vælg rolle</option>
                            @foreach (var role in Roles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="bi bi-activity"></i>
                            Status
                        </label>
                        <select @bind="newUser.Status" class="form-select">
                            <option value="" disabled selected>Vælg status</option>
                            <option value="Aktiv">Aktiv</option>
                            <option value="Inaktiv">Inaktiv</option>
                        </select>
                    </div>

                    @if (newUser.Role == "Elev")
                    {
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-mortarboard"></i>
                                Skoletype
                            </label>
                            <select @bind="newUser.SchoolType" class="form-select">
                                <option value="" disabled selected>Vælg skole</option>
                                <option value="EUX">EUX</option>
                                <option value="EUV">EUV</option>
                                <option value="Voksenelev">Voksenelev</option>
                                <option value="Ordinær">Ordinær</option>
                            </select>
                        </div>
                    }
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn-cancel" @onclick="CloseCreateModal">Annuller</button>
                    <button type="button" class="btn-primary" @onclick="SaveUserAsync" disabled="@(!IsFormValid)">
                        <i class="bi bi-check-lg"></i>
                        Gem bruger
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static readonly List<string> Roles = new() { "Elev", "Køkkenchef", "HR", "Kok" }; // Roller der kan vælges
    private User? currentUser; // Den aktuelle loggede bruger
    private List<User> users = new(); // Liste over alle brugere
    private List<string> hotels = new(); // Liste over hoteller brugt til filtrering
    
    // Filtrering
    private string searchTerm = ""; // Søgefelt til filtrering af brugere baseret på navn
    private string selectedRole = ""; // Valgt rolle til filtrering
    private string selectedHotel = ""; // Valgt hotel til filtrering
    
    // UI
    private int? activeActionMenuUserId; // Holder styr på hvilken bruger man via (⋮) vil slette eller gøre Inaktiv/Aktiv
    private bool showCreateModal; // Viser/skjuler opret bruger-modal
    
    // Tilføj bruger
    private User newUser = new(); // Den bruger der oprettes
    private string errorMessage = ""; // Fejlbesked
    
    // Form validation
    private bool IsFormValid => 
        !string.IsNullOrWhiteSpace(newUser.Name) && 
        !string.IsNullOrWhiteSpace(newUser.Email) && 
        !string.IsNullOrWhiteSpace(newUser.Password) && 
        !string.IsNullOrWhiteSpace(newUser.Role) && 
        !string.IsNullOrWhiteSpace(newUser.Status) &&
        (newUser.Role != "Elev" || !string.IsNullOrWhiteSpace(newUser.SchoolType));

    // Returnerer en liste over brugere filtreret ud fra søgefelt, rolle og hotel
    private IEnumerable<User> FilteredUsers =>
        users.Where(u =>
            (string.IsNullOrEmpty(searchTerm) || u.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(selectedRole) || u.Role == selectedRole) &&
            (string.IsNullOrEmpty(selectedHotel) || u.Hotel == selectedHotel));

    // Formål: Initialiserer siden ved at hente den aktuelle bruger, brugerliste og hoteller.
    protected override async Task OnInitializedAsync()
    {
        currentUser = await UserService.GetCurrentUserAsync();
        users = await UserService.GetAllUsersAsync();
        hotels = users
            .Select(u => u.Hotel) // Tager alle brugers hotel
            .Where(h => !string.IsNullOrEmpty(h)) // Fjerner tomme eller null hoteller
            .Distinct() // Sørger for at hvert hotel kun vises en gang
            .OrderBy(h => h) // Sortere listen i alfabetisk rækkefølge
            .ToList(); // Laver det om til en liste, som gemmes i hotels
    }

    // Formål: Åbner modal-vinduet til oprettelse af en ny bruger.
    private async Task CreateUser()
    {
        showCreateModal = true;
        newUser = new();
        errorMessage = "";
        
        // Prevent body scroll
        await JSRuntime.InvokeVoidAsync("preventBodyScroll", true);
    }
    
    // Formål: Lukker modal-vinduet uden at gemme noget.
    private async Task CloseCreateModal()
    {
        showCreateModal = false;
        
        // Restore body scroll
        await JSRuntime.InvokeVoidAsync("preventBodyScroll", false);
    }

    // Formål: Gemmer en ny bruger i databasen.
    private async Task SaveUserAsync()
    {
        // Validering
        if (string.IsNullOrWhiteSpace(newUser.Name))
        {
            errorMessage = "Indtast venligst et navn.";
            return;
        }
        
        if (string.IsNullOrWhiteSpace(newUser.Email))
        {
            errorMessage = "Indtast venligst en email.";
            return;
        }
        
        if (string.IsNullOrWhiteSpace(newUser.Password))
        {
            errorMessage = "Indtast venligst en adgangskode.";
            return;
        }
        
        if (string.IsNullOrWhiteSpace(newUser.Role))
        {
            errorMessage = "Vælg venligst en rolle.";
            return;
        }
        
        if (string.IsNullOrWhiteSpace(newUser.Status))
        {
            errorMessage = "Vælg venligst en status.";
            return;
        }
        
        if (newUser.Role == "Elev" && string.IsNullOrWhiteSpace(newUser.SchoolType))
        {
            errorMessage = "Vælg venligst en skoletype for elever.";
            return;
        }

        try
        {
            var result = await UserService.CreateUserAsync(newUser);
            if (result == null) 
            {
                errorMessage = "Noget gik galt under oprettelsen. Prøv venligst igen.";
                return;
            }
            
            users = await UserService.GetAllUsersAsync();
            showCreateModal = false;
            
            // Restore body scroll
            await JSRuntime.InvokeVoidAsync("preventBodyScroll", false);
        }
        catch (Exception ex)
        {
            errorMessage = $"Fejl ved oprettelse af bruger: {ex.Message}";
        }
    }

    // Formål: Sletter en bruger.
    private async Task DeleteUserAsync(int userId)
    {
        if (currentUser?.Role == "HR" && await UserService.DeleteUserAsync(userId))
        {
            users = await UserService.GetAllUsersAsync();
        }
        activeActionMenuUserId = null;
    }

    // Formål: Viser eller skjuler action-menuen (⋮) for en bestemt bruger.
    private void ToggleActionMenu(int userId) =>
        activeActionMenuUserId = activeActionMenuUserId == userId ? null : userId;

    // Formål: Returnerer initialer ud fra brugerens fulde navn.
    private static string GetInitials(string fullName)
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "",
            1 => parts[0][..1].ToUpper(),
            _ => $"{parts[0][..1]}{parts[^1][..1]}".ToUpper()
        };
    }
    
    // Formål: Skifter en brugers status mellem Aktiv og Inaktiv.
    private async Task ToggleUserStatusAsync(User user)
    {
        var newStatus = user.Status == "Aktiv" ? "Inaktiv" : "Aktiv";
        if (await UserService.UpdateUserStatusAsync(user.Id, newStatus))
        {
            users = await UserService.GetAllUsersAsync();
        }
        activeActionMenuUserId = null;
    }

    // Returnerer CSS klasse baseret på rolle
    private static string GetRoleClass(string role) => role switch
    {
        "Elev" => "students",
        "Køkkenchef" => "chef", 
        "HR" => "hr",
        "Kok" => "cook",
        _ => "default"
    };

    // Returnerer bootstrap ikon baseret på rolle
    private static string GetRoleIcon(string role) => role switch
    {
        "Elev" => "bi bi-mortarboard-fill",
        "Køkkenchef" => "bi bi-award-fill",
        "HR" => "bi bi-person-badge-fill",
        "Kok" => "bi bi-egg-fried",
        _ => "bi bi-person-fill"
    };
}

<script>
    window.preventBodyScroll = (prevent) => {
        if (prevent) {
            document.body.style.overflow = 'hidden';
        } else {
            document.body.style.overflow = '';
        }
    };
</script>
