@page "/elevplaner"
@attribute [Authorize(Roles = "HR,Køkkenchef,Kok")]
@using WebApp.Services
@using WebApp.Components.StudentPlan
@using Core.Models
@inject IStudentPlanService StudentPlanService
@inject IUserService UserService
@inject ITemplateService TemplateService
@inject ILearningMaterialService MaterialService
@inject NavigationManager Nav

<!-- Modern StudentPlan Dashboard -->
<div class="dashboard-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-title-section">
            <h1 class="page-title">
                <i class="bi bi-file-earmark-text me-3"></i>
                Elevplaner
            </h1>
            <p class="page-description">Her er et samlet overblik over alle elevplaner.</p>
        </div>
        
        @if (currentUser != null && currentUser.Role != "Elev" && currentUser.Role != "Kok")
        {
            <div class="page-actions">
                <button class="btn-create" @onclick="OpenCreatePlanModal">
                    <i class="bi bi-plus-circle me-2"></i>
                    Opret plan
                </button>
            </div>
        }
    </div>

    <!-- Stats Section -->
    <div class="stats-grid">
        <div class="stat-card total">
            <div class="stat-icon">
                <i class="bi bi-file-earmark-text-fill"></i>
            </div>
            <div class="stat-info">
                <div class="stat-number">@(plans?.Count ?? 0)</div>
                <div class="stat-label">Totale planer</div>
            </div>
        </div>
        
        <div class="stat-card active">
            <div class="stat-icon">
                <i class="bi bi-play-circle-fill"></i>
            </div>
            <div class="stat-info">
                <div class="stat-number">@(plans?.Count(p => p.Goals.Any(g => g.Subtasks.Any(s => s.Status == "I gang"))) ?? 0)</div>
                <div class="stat-label">Aktive planer</div>
            </div>
        </div>
        
        <div class="stat-card approved">
            <div class="stat-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="stat-info">
                <div class="stat-number">@(plans?.Count(p => p.IsApprovedByChef) ?? 0)</div>
                <div class="stat-label">Godkendte planer</div>
            </div>
        </div>
        
        <div class="stat-card students">
            <div class="stat-icon">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="stat-info">
                <div class="stat-number">@(plans?.Select(p => p.StudentId).Distinct().Count() ?? 0)</div>
                <div class="stat-label">Elever med planer</div>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="filters-section">
        <div class="filters-header">
            <h3 class="filters-title">
                <i class="bi bi-funnel me-2"></i>
                Filtrer planer
            </h3>
        </div>
        <div class="filters-content">
            <div class="filter-group">
                <label class="filter-label">
                    <i class="bi bi-building me-2"></i>
                    Hotel
                </label>
                <select @bind="selectedHotel" class="filter-select">
                    <option value="">Alle hoteller</option>
                    @foreach (var hotel in allHotels)
                    {
                        <option value="@hotel">@hotel</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label class="filter-label">
                    <i class="bi bi-person me-2"></i>
                    Elev
                </label>
                <select @bind="selectedStudentId" class="filter-select">
                    <option value="-1">Alle elever</option>
                    @foreach (var user in FilteredUsers)
                    {
                        <option value="@user.Id">
                            @user.Name (@user.Hotel)
                        </option>
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- Content Section -->
    <div class="content-section">
        <div class="section-header">
            <h3 class="section-title">
                <i class="bi bi-list-ul me-2"></i>
                Elevplaner (@(FilteredPlans().Count()))
            </h3>
        </div>

        @if (plans?.Any() != true)
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-file-earmark-text"></i>
                </div>
                <h4>Ingen planer fundet</h4>
                <p>Der er ikke oprettet nogen elevplaner endnu.</p>
                @if (currentUser != null && currentUser.Role != "Elev" && currentUser.Role != "Kok")
                {
                    <button class="btn-create" @onclick="OpenCreatePlanModal">
                        <i class="bi bi-plus-circle me-2"></i>
                        Opret første plan
                    </button>
                }
            </div>
        }
        else
        {
            <div class="materials-grid">
                @foreach (var plan in FilteredPlans())
                {
                    <div class="material-card">
                        <!-- Plan Header -->
                        <div class="material-header">
                            <div class="material-type-icon">
                                <i class="bi bi-file-earmark-text-fill"></i>
                            </div>
                            <div class="material-info">
                                <h5 class="material-title">@templates.FirstOrDefault(t => t.Id == plan.TemplateId)?.Title</h5>
                                <div class="material-metadata">
                                    <span class="material-subtask">
                                        <i class="bi bi-person me-1"></i>
                                        @userNamesById.GetValueOrDefault(plan.StudentId, "(Ukendt)")
                                    </span>
                                    <span class="material-date">
                                        <i class="bi bi-calendar me-1"></i>
                                        @plan.PeriodStart.ToShortDateString() - @plan.PeriodEnd.ToShortDateString()
                                    </span>
                                    <span class="material-date">
                                        <i class="bi bi-person-badge me-1"></i>
                                        @plan.CreatedBy
                                    </span>
                                </div>
                            </div>
                            <div class="material-actions">
                                <button class="action-menu-btn" @onclick="() => ToggleActionMenu(plan.Id)">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                                @if (activeActionMenuPlanId == plan.Id)
                                {
                                    <div class="action-menu">
                                        <button class="delete-button" @onclick="() => DeleteStudentPlanAsync(plan.Id)">
                                            <i class="bi bi-trash me-1"></i> Slet
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Plan Content -->
                        <div class="material-content">
                            <!-- Approval Section -->
                            @if (currentUser?.Role == "Køkkenchef")
                            {
                                if (!plan.IsApprovedByChef)
                                {
                                    <div class="approval-section">
                                        <button class="btn-approve" @onclick="() => ApprovePlan(plan)">
                                            <i class="bi bi-check-circle me-2"></i> Godkend praktikperiode
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="approval-status approved">
                                        <i class="bi bi-check-circle-fill me-2"></i>
                                        <span>Praktikperiode godkendt af køkkenchef</span>
                                    </div>
                                }
                            }
                            else if (plan.IsApprovedByChef)
                            {
                                <div class="approval-status approved">
                                    <i class="bi bi-check-circle-fill me-2"></i>
                                    <span>Praktikperiode godkendt af køkkenchef</span>
                                </div>
                            }

                            <!-- Goals Summary -->
                            <div class="goals-summary">
                                <div class="summary-item">
                                    <i class="bi bi-target me-2"></i>
                                    <span>@plan.Goals.Count mål</span>
                                </div>
                                <div class="summary-item">
                                    <i class="bi bi-list-task me-2"></i>
                                    <span>@plan.Goals.Sum(g => g.Subtasks.Count) delmål</span>
                                </div>
                                <div class="summary-item">
                                    <i class="bi bi-check-square me-2"></i>
                                    <span>@plan.Goals.Sum(g => g.Subtasks.Count(s => s.Status == "Fuldført")) fuldført</span>
                                </div>
                            </div>

                            <!-- School Periods Summary -->
                            @if (plan.SchoolPeriods.Any())
                            {
                                <div class="school-periods-summary">
                                    <h6>
                                        <i class="bi bi-mortarboard me-2"></i>
                                        Skoleperioder (@plan.SchoolPeriods.Count)
                                    </h6>
                                    <div class="periods-list">
                                        @foreach (var school in plan.SchoolPeriods.Take(3))
                                        {
                                            <div class="period-item">
                                                <span class="period-title">@school.Title</span>
                                                <span class="period-status @school.Status.ToLower().Replace(" ", "-")">@school.Status</span>
                                            </div>
                                        }
                                        @if (plan.SchoolPeriods.Count > 3)
                                        {
                                            <div class="period-item">
                                                <span class="period-more">+@(plan.SchoolPeriods.Count - 3) flere...</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Plan Footer -->
                        <div class="material-footer">
                            <button class="btn-expand @(openPlanIds.Contains(plan.Id) ? "expanded" : "")" @onclick="() => TogglePlan(plan.Id)">
                                <i class="bi bi-chevron-right me-2"></i>
                                <span>@(openPlanIds.Contains(plan.Id) ? "Skjul detaljer" : "Vis detaljer")</span>
                            </button>
                        </div>

                        <!-- Expanded Details -->
                        @if (openPlanIds.Contains(plan.Id))
                        {
                            <div class="expanded-details">
                                <!-- Goals Section -->
                                <div class="goals-section">
                                    <h6>
                                        <i class="bi bi-target me-2"></i>
                                        Mål (@plan.Goals.Count)
                                    </h6>
                                    @foreach (var goal in plan.Goals)
                                    {
                                        <GoalDisplayComponent
                                            goal="goal"
                                            plans="plans"
                                            plan="plan"
                                            allMaterials="allMaterials"
                                            currentUser="currentUser"
                                            refresh="EventCallback.Factory.Create(this, () => StateHasChanged())"/>
                                    }

                                    <button class="btn-add-goal" @onclick="() => StartAddingNewGoal(plan.Id)">
                                        <i class="bi bi-plus me-2"></i>
                                        <span>Tilføj nyt mål</span>
                                    </button>

                                    @if (newGoalPlanId == plan.Id)
                                    {
                                        <div class="new-goal-form">
                                            <h6>Nyt mål</h6>
                                            <div class="form-group">
                                                <label class="form-label">Titel:</label>
                                                <input type="text" @bind="newGoalTitle" class="form-input" />
                                            </div>

                                            <div class="form-group">
                                                <label class="form-label">Kategori:</label>
                                                <select @bind="newGoalCategory" class="form-select">
                                                    <option value="Skole">Skole</option>
                                                    <option value="Praktik">Praktik</option>
                                                </select>
                                            </div>

                                            <div class="form-actions">
                                                <button class="btn-secondary" @onclick="CancelAddGoal">Annuller</button>
                                                <button class="btn-primary" @onclick="() => ConfirmAddGoal(plan)">
                                                    <i class="bi bi-plus me-2"></i> Tilføj
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- School Periods Section -->
                                <div class="school-periods-section">
                                    <h6>
                                        <i class="bi bi-mortarboard me-2"></i>
                                        Skoleperioder
                                    </h6>
                                    
                                    <div class="school-periods-grid">
                                        @foreach (var school in plan.SchoolPeriods)
                                        {
                                            <div class="school-period-card @(school.Status.ToLower().Replace(" ", "-"))">
                                                <div class="period-header">
                                                    <h6 class="period-title">
                                                        <i class="bi bi-mortarboard me-2"></i>
                                                        @school.Title
                                                    </h6>
                                                    <span class="status-badge @school.Status.ToLower().Replace(" ", "-")">
                                                        @school.Status
                                                    </span>
                                                </div>
                                                
                                                <div class="period-details">
                                                    @if (school.StartDate.HasValue && school.IsDateConfirmed)
                                                    {
                                                        var start = school.StartDate.Value;
                                                        var end = start.AddDays(7 * school.DurationWeeks);
                                                        <div class="period-dates confirmed">
                                                            <i class="bi bi-calendar-check me-2"></i>
                                                            <span>@start.ToString("dd.MM.yyyy") - @end.ToString("dd.MM.yyyy")</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="period-dates pending">
                                                            <i class="bi bi-calendar-x me-2"></i>
                                                            <span>Dato ikke valgt endnu</span>
                                                        </div>
                                                    }

                                                    @if (school.IsApproved)
                                                    {
                                                        <div class="approval-status approved">
                                                            <i class="bi bi-check-circle-fill me-2"></i>
                                                            <span>Skoleperiode godkendt af køkkenchef</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Modal for Opret Plan -->
@if (showCreatePlanModal)
{
    <div class="modal-overlay" @onclick="CloseCreatePlanModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h4 class="modal-title">
                    <i class="bi bi-plus-circle"></i>
                    Opret ny elevplan
                </h4>
                <button class="modal-close" @onclick="CloseCreatePlanModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-body">
                <!-- Viser feedbackbesked hvis der er en -->
                @if (!string.IsNullOrEmpty(feedbackMessage))
                {
                    <div class="alert alert-warning">@feedbackMessage</div>
                }

                <!-- Formular til oprettelse af elevplan -->
                <EditForm Model="planModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="validation-summary" />

                    <div class="form-group">
                        <label class="form-label">Vælg elev:</label>
                        <select @bind="planModel.StudentId" class="form-select">
                            <option value="">Vælg en elev</option>
                            @foreach (var user in students)
                            {
                                <option value="@user.Id">@user.Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Vælg skabelon:</label>
                        <select @bind="planModel.TemplateId" @bind:after="OnTemplateChanged" class="form-select">
                            <option value="">Vælg en skabelon</option>
                            @foreach (var template in templates)
                            {
                                <option value="@template.Id">@template.Title</option>
                            }
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">Startdato:</label>
                        <InputDate @bind-Value="planModel.PeriodStart" class="form-input" />
                    </div>

                    <div class="modal-actions">
                        <button type="button" class="btn-cancel" @onclick="CloseCreatePlanModal">Annuller</button>
                        <button type="submit" class="btn-primary">Gem plan</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    // Holder styr på plan-relaterede data
    private List<StudentPlan> plans = new();                     // Liste over alle elevplaner
    private List<Template> templates = new();                    // Liste over skabeloner
    private List<LearningMaterial> allMaterials = new();         // Liste over alt læringsmateriale
    private User? currentUser;                                   // Bruger der er logget ind
    private Dictionary<int, string> userNamesById = new();       // Slår StudentId op til navn

    // Filter – holder styr på filtervalg
    private List<User> allUsers = new();                         // Liste over alle brugere
    private List<string> allHotels = new();                      // Liste over alle hoteller
    private int selectedStudentId = -1;                          // ID på valgt elev (-1 = alle)
    private string selectedHotel = "";                           // Valgt hotel

    // UI – styrer hvilke sektioner der er åbne
    private HashSet<int> openPlanIds = new();                    // Åbne planer (vis mål)
    private HashSet<int> openNotePlanIds = new();                // Åbne noter
    private int activeActionMenuPlanId = -1;                     // ID på planen med åben menu

    // Goal – styrer mål der tilføjes
    private int newGoalPlanId = -1;                               // ID på plan der tilføjes mål til
    private string newGoalTitle = "";                             // Titel på nyt mål
    private string newGoalCategory = "";                          // Kategori på nyt mål

    // Note – styrer noter der tilføjes
    private int addingNoteForPlanId = -1;                         // ID på plan der tilføjes note til
    private Dictionary<int, string> newNoteTexts = new();         // Tekster til nye noter
    
    // Modal – styrer opret plan modal
    private bool showCreatePlanModal = false;                     // Viser/skjuler modal
    private List<User> students = new();                          // Liste over elever til dropdown
    private string feedbackMessage = "";                          // Feedback til brugeren
    private StudentPlan planModel = new() { PeriodStart = DateTime.Today }; // Model til ny plan

    // Formål: Initialiserer siden. Henter brugerdata og elevplaner, medmindre man er elev.
    protected override async Task OnInitializedAsync()
    {
        currentUser = await UserService.GetCurrentUserAsync();
        if (currentUser?.Role == "Elev")
        {
            Nav.NavigateTo("/");
            return;
        }

        await LoadData(); // Henter alle data til siden
    }

    // Formål: Henter alle brugere, hoteller, planer, skabeloner, læringsmaterialer og opdaterer status på skoleperioder.
    private async Task LoadData()
    {
        allUsers = await UserService.GetAllUsersAsync();
        allHotels = allUsers
            .Where(u => !string.IsNullOrWhiteSpace(u.Hotel))
            .Select(u => u.Hotel)
            .Distinct()
            .OrderBy(h => h)
            .ToList();

        plans = await StudentPlanService.GetPlansByUserAsync(currentUser!);
        allMaterials = await MaterialService.GetAllAsync();
        templates = await TemplateService.GetAllTemplatesAsync();
        students = allUsers.Where(u => u.Role == "Elev").ToList(); // Hent elever til modal
        await UpdateSchoolPeriodStatuses(); 

        // Bruges til at finde navnet på elever baseret på Id
        foreach (var plan in plans)
        {
            if (!userNamesById.ContainsKey(plan.StudentId))
            {
                var user = await UserService.GetUserByIdAsync(plan.StudentId);
                userNamesById[plan.StudentId] = user?.Name ?? "(Ukendt)";
            }
        }
    }

    // Formål: Opdaterer status på skoleperioder. Ændrer status på skoleperioder automatisk hvis startdato er nået.
    private async Task UpdateSchoolPeriodStatuses()
    {
        var updatedPlans = false;
        var plansToUpdate = new List<StudentPlan>();
        
        // Sætter skoleperiode i gang hvis startdato er nået.
        foreach (var plan in plans)
        {
            var planUpdated = false;
            foreach (var school in plan.SchoolPeriods)
            {
                if (school.Status == "Ikke startet" && school.StartDate <= DateTime.Today)
                {
                    school.Status = "I gang";
                    planUpdated = true;
                }
            }
            
            if (planUpdated)
            {
                plansToUpdate.Add(plan);
                updatedPlans = true;
            }
        }

        if (updatedPlans)
        {
            await Task.WhenAll(plansToUpdate.Select(plan => StudentPlanService.UpdateStudentPlanAsync(plan)));
        }
    }
    
    // Returnerer: Liste over elever filtreret på hotel.
    // Formål: Viser kun elever, og filtrerer dem hvis der er valgt et hotel.
    private IEnumerable<User> FilteredUsers => allUsers
        .Where(u => u.Role == "Elev" && 
                    (string.IsNullOrEmpty(selectedHotel) || u.Hotel == selectedHotel))
        .OrderBy(u => u.Name);

    // Returnerer: Liste af filtrerede elevplaner.
    // Formål: Filtrerer planer efter valgt hotel og/eller elev.
    private IEnumerable<StudentPlan> FilteredPlans()
    {
        var filtered = plans.AsEnumerable();

        if (!string.IsNullOrEmpty(selectedHotel))
        {
            var studentIds = FilteredUsers.Select(u => u.Id).ToHashSet();
            filtered = filtered.Where(p => studentIds.Contains(p.StudentId));
            
            if (selectedStudentId != -1 && !studentIds.Contains(selectedStudentId))
            {
                selectedStudentId = -1;
            }
        }

        if (selectedStudentId != -1)
        {
            filtered = filtered.Where(p => p.StudentId == selectedStudentId);
        }

        return filtered.OrderBy(p => userNamesById.GetValueOrDefault(p.StudentId, "(Ukendt)"));
    }

    // Formål: Åbner eller lukker planer for at vise/skjule målene.
    // Parametre: planId – ID på planen der skal foldes ud eller ind.
    private void TogglePlan(int planId)
    {
        if (!openPlanIds.Add(planId))
            openPlanIds.Remove(planId);
    }

    // Formål: Åbner eller lukker noter sektionen for en plan.
    // Parametre: planId – ID på planen hvor noter skal vises/skjules.
    private void ToggleNotes(int planId)
    {
        if (!openNotePlanIds.Add(planId))
            openNotePlanIds.Remove(planId);
    }

    // Formål: Viser eller skjuler handlingsmenu for en plan.
    // Parametre: planId – ID på planen hvor menuen skal vises/skjules.
    private void ToggleActionMenu(int planId)
    {
        activeActionMenuPlanId = activeActionMenuPlanId == planId ? -1 : planId;
    }

    // Formål: Godkender en elevplan som køkkenchef.
    // Parametre: plan – Den plan der skal godkendes.
    private async Task ApprovePlan(StudentPlan plan)
    {
        plan.IsApprovedByChef = true;
        await StudentPlanService.UpdateStudentPlanAsync(plan);
        await LoadData();
    }

    // Formål: Godkender en skoleperiode som køkkenchef.
    // Parametre: plan – Planen perioden hører til, school – Den skoleperiode der skal godkendes.
    private async Task ApproveSchoolPeriod(StudentPlan plan, SchoolPeriod school)
    {
        school.IsApproved = true;
        await StudentPlanService.UpdateStudentPlanAsync(plan);
        await LoadData();
    }

    // Formål: Gemmer valgt startdato for en skoleperiode.
    // Parametre: plan – Planen perioden hører til, school – Den skoleperiode hvis dato skal gemmes.
    private async Task SaveSchoolPeriodDate(StudentPlan plan, SchoolPeriod school)
    {
        school.IsDateConfirmed = true;
        await StudentPlanService.UpdateStudentPlanAsync(plan);
        await LoadData();
    }

    // Formål: Sletter en elevplan.
    // Parametre: planId – ID på planen der skal slettes.
    private async Task DeleteStudentPlanAsync(int planId)
    {
        var plan = plans.FirstOrDefault(p => p.Id == planId);
        if (plan != null)
        {
            await StudentPlanService.DeleteStudentPlanAsync(planId);
            await LoadData();
        }
        activeActionMenuPlanId = -1;
    }

    // Formål: Starter processen med at tilføje et nyt mål til en plan.
    // Parametre: planId – ID på planen hvor målet skal tilføjes.
    private void StartAddingNewGoal(int planId)
    {
        newGoalPlanId = planId;
        newGoalTitle = "";
        newGoalCategory = "Praktik";
    }

    // Formål: Annullerer tilføjelse af nyt mål.
    private void CancelAddGoal()
    {
        newGoalPlanId = -1;
        newGoalTitle = "";
        newGoalCategory = "";
    }

    // Formål: Bekræfter og tilføjer et nyt mål til planen.
    // Parametre: plan – Planen hvor målet skal tilføjes til.
    private async Task ConfirmAddGoal(StudentPlan plan)
    {
        if (string.IsNullOrWhiteSpace(newGoalTitle)) return;

        var newGoal = new Goal
        {
            Title = newGoalTitle,
            Category = newGoalCategory,
            Status = "Ikke startet",
            Deadline = DateTime.Today.AddDays(30), // Standard deadline på 30 dage
            Subtasks = new List<Subtask>()
        };

        plan.Goals.Add(newGoal);
        await StudentPlanService.UpdateStudentPlanAsync(plan);
        await LoadData();

        // Nulstil formular
        newGoalPlanId = -1;
        newGoalTitle = "";
        newGoalCategory = "";
    }

    // Formål: Starter processen med at tilføje en note til en plan.
    // Parametre: planId – ID på planen hvor noten skal tilføjes.
    private void StartAddNote(int planId)
    {
        addingNoteForPlanId = planId;
        if (!newNoteTexts.ContainsKey(planId))
            newNoteTexts[planId] = "";
    }

    // Formål: Annullerer tilføjelse af note.
    private void CancelAddNote()
    {
        addingNoteForPlanId = -1;
    }

    // Formål: Gemmer en ny note til planen.
    // Parametre: plan – Planen hvor noten skal gemmes.
    private async Task SaveNote(StudentPlan plan)
    {
        var noteText = newNoteTexts.GetValueOrDefault(plan.Id, "").Trim();
        if (string.IsNullOrEmpty(noteText)) return;

        var note = new Note
        {
            Text = noteText,
            CreatedAt = DateTime.Now
        };

        plan.Notes.Add(note);
        await StudentPlanService.UpdateStudentPlanAsync(plan);
        await LoadData();

        // Nulstil
        addingNoteForPlanId = -1;
        newNoteTexts[plan.Id] = "";
    }

    // Formål: Sletter en note fra planen.
    // Parametre: plan – Planen hvor noten skal slettes fra, noteId – ID på noten der skal slettes.
    private async Task DeleteNote(StudentPlan plan, int noteId)
    {
        plan.Notes.RemoveAll(n => n.Id == noteId);
        await StudentPlanService.UpdateStudentPlanAsync(plan);
        await LoadData();
    }

    // Returnerer: En CSS-klasse baseret på status.
    // Parametre: status – Status på skoleperiode eller mål.
    // Formål: Returnerer korrekt baggrundsfarve baseret på status (bruges til badges i UI).
    private static string GetStatusClass(string status) => status switch
    {
        "Fuldført" => "bg-success",
        "I gang" => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    // Modal metoder for Opret Plan
    private void OpenCreatePlanModal()
    {
        showCreatePlanModal = true;
        feedbackMessage = "";
        planModel = new StudentPlan { PeriodStart = DateTime.Today };
    }

    private void CloseCreatePlanModal()
    {
        showCreatePlanModal = false;
        feedbackMessage = "";
        planModel = new StudentPlan { PeriodStart = DateTime.Today };
    }

    // Når en skabelon vælges
    private async Task OnTemplateChanged()
    {
        if (planModel.TemplateId > 0)
        {
            var selectedTemplate = templates.FirstOrDefault(t => t.Id == planModel.TemplateId);
            if (selectedTemplate != null)
            {
                await ApplyTemplateGoalsToPlan(selectedTemplate);
            }
        }
    }

    // Kopierer mål fra skabelon til plan
    private Task ApplyTemplateGoalsToPlan(Template selectedTemplate)
    {
        planModel.Goals.Clear();
        
        foreach (var templateGoal in selectedTemplate.Goals)
        {
            var newGoal = new Goal
            {
                Id = templateGoal.Id,
                Title = templateGoal.Title,
                Category = templateGoal.Category,
                Status = "Ikke startet",
                Subtasks = templateGoal.Subtasks.Select(st => new Subtask
                {
                    Id = st.Id,
                    Text = st.Text,
                    Status = "Ikke startet",
                }).ToList(),
                Deadline = DateTime.Today.AddDays(30)
            };
            
            planModel.Goals.Add(newGoal);
        }
        
        StateHasChanged();
        return Task.CompletedTask;
    }

    // Håndterer form submit for ny plan
    private async Task HandleSubmit()
    {
        if (planModel.StudentId <= 0)
        {
            feedbackMessage = "Vælg venligst en elev.";
            return;
        }

        if (planModel.TemplateId <= 0)
        {
            feedbackMessage = "Vælg venligst en skabelon.";
            return;
        }

        try
        {
            // Sæt standard værdier
            planModel.PeriodEnd = planModel.PeriodStart.AddDays(20 * 7); // 20 uger
            planModel.CreatedBy = currentUser?.Name ?? "Ukendt";
            planModel.IsApprovedByChef = false;
            
            // Opret standard skoleperioder
            planModel.SchoolPeriods = new List<SchoolPeriod>
            {
                new SchoolPeriod
                {
                    Title = "Skoleperiode 1",
                    DurationWeeks = 5,
                    Status = "Ikke startet",
                    IsDateConfirmed = false,
                    IsApproved = false
                },
                new SchoolPeriod
                {
                    Title = "Skoleperiode 2", 
                    DurationWeeks = 5,
                    Status = "Ikke startet",
                    IsDateConfirmed = false,
                    IsApproved = false
                }
            };

            planModel.Notes = new List<Note>();

            await StudentPlanService.CreateStudentPlanAsync(planModel);
            await LoadData();
            CloseCreatePlanModal();
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Fejl ved oprettelse af plan: {ex.Message}";
        }
    }
}

