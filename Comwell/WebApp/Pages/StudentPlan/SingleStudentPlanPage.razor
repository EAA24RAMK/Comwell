@page "/elevplan"
@using WebApp.Services
@using WebApp.Components
@using Core.Models
@inject IStudentPlanService StudentPlanService
@inject IUserService UserService
@inject ITemplateService TemplateService
@inject ILearningMaterialService MaterialService
@inject NavigationManager Nav

<!-- Modern Single Student Plan Dashboard -->
<div class="single-elevplan-dashboard">
    <!-- Executive Header with Dark Blue Background -->
    <div class="page-header">
        <div class="header-content">
            <h3>
                <i class="bi bi-person-workspace"></i>
                @(currentUser?.Name) - Min Elevplan
            </h3>
            <p class="welcome-text">Her er dit personlige overblik over din elevplan og fremskridt.</p>
        </div>
        <div class="header-stats">
            <div class="stat-card">
                <div class="stat-number">@(plans?.Count ?? 0)</div>
                <div class="stat-label">
                    <i class="bi bi-journal-bookmark"></i>
                    Planer
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-number">@GetTotalGoals()</div>
                <div class="stat-label">
                    <i class="bi bi-target"></i>
                    Mål
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-number">@GetCompletedGoalsPercentage()%</div>
                <div class="stat-label">
                    <i class="bi bi-trophy"></i>
                    Gennemført
                </div>
            </div>
        </div>
    </div>

    <!-- Plans Content -->
    <div class="plans-content">
        @if (plans?.Any() != true)
        {
            <div class="empty-state">
                <i class="bi bi-journal-x"></i>
                <h4>Ingen planer fundet</h4>
                <p>Der er ikke oprettet nogen planer til dig endnu. Kontakt din vejleder for at få oprettet en plan.</p>
            </div>
        }
        else
        {
            @foreach (var plan in plans)
            {
                <div class="plan-container">
                    <!-- Plan Header -->
                    <div class="plan-header">
                        <div class="plan-info">
                            <h4 class="plan-title">
                                <i class="bi bi-clipboard2-check"></i>
                                @templates.FirstOrDefault(t => t.Id == plan.TemplateId)?.Title
                            </h4>
                            <div class="plan-meta">
                                <div class="meta-item">
                                    <i class="bi bi-calendar-range"></i>
                                    <span><strong>Periode:</strong> @plan.PeriodStart.ToShortDateString() - @plan.PeriodEnd.ToShortDateString()</span>
                                </div>
                                <div class="meta-item">
                                    <i class="bi bi-person-check"></i>
                                    <span><strong>Oprettet af:</strong> @plan.CreatedBy</span>
                                </div>
                            </div>
                        </div>
                        @if (plan.IsApprovedByChef)
                        {
                            <div class="approval-badge">
                                <i class="bi bi-patch-check-fill"></i>
                                <span>Godkendt</span>
                            </div>
                        }
                    </div>

                    <!-- Goals Section -->
                    <div class="section-container">
                        <button class="section-toggle @(openPlanIds.Contains(plan.Id) ? "expanded" : "")" @onclick="() => TogglePlan(plan.Id)">
                            <i class="bi bi-chevron-right"></i>
                            <span>Mål (@plan.Goals.Count)</span>
                            <div class="progress-indicator">
                                <div class="progress-bar" style="width: @GetPlanProgressPercentage(plan)%"></div>
                            </div>
                        </button>

                        @if (openPlanIds.Contains(plan.Id))
                        {
                            <div class="goals-grid">
                                @foreach (var goal in plan.Goals)
                                {
                                    <div class="goal-card">
                                        <div class="goal-header">
                                            <div class="goal-info">
                                                <h5 class="goal-title">
                                                    <i class="bi bi-bullseye"></i>
                                                    @goal.Title
                                                </h5>
                                                <div class="goal-meta">
                                                    <span class="goal-category">
                                                        <i class="bi bi-tag"></i>
                                                        @goal.Category
                                                    </span>
                                                    <span class="goal-deadline @(goal.Deadline < DateTime.Today ? "overdue" : "")">
                                                        <i class="bi bi-clock"></i>
                                                        @goal.Deadline.ToString("dd-MM-yyyy")
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="goal-status">
                                                @if (goal.Status == "Ikke startet")
                                                {
                                                    <span class="status-badge not-started">
                                                        <i class="bi bi-hourglass"></i>
                                                        Ikke startet
                                                    </span>
                                                }
                                                else if (goal.Status == "I gang")
                                                {
                                                    <span class="status-badge in-progress">
                                                        <i class="bi bi-play-circle"></i>
                                                        I gang
                                                    </span>
                                                }
                                                else if (goal.Status == "Fuldført")
                                                {
                                                    <span class="status-badge completed">
                                                        <i class="bi bi-check-circle-fill"></i>
                                                        Fuldført
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        <button class="subtasks-toggle @(openGoalIds.Contains(goal.Id) ? "expanded" : "")" @onclick="() => ToggleGoal(goal.Id)">
                                            <i class="bi bi-chevron-right"></i>
                                            <span>Delmål (@goal.Subtasks.Count)</span>
                                            <div class="subtask-progress">
                                                @{
                                                    var completedSubtasks = goal.Subtasks.Count(s => s.Status == "Fuldført");
                                                    var totalSubtasks = goal.Subtasks.Count;
                                                }
                                                <span class="progress-text">@completedSubtasks / @totalSubtasks</span>
                                            </div>
                                        </button>

                                        @if (openGoalIds.Contains(goal.Id))
                                        {
                                            <div class="subtasks-list">
                                                @foreach (var subtask in goal.Subtasks)
                                                {
                                                    <div class="subtask-item @(subtask.Status.ToLower().Replace(" ", "-"))">
                                                        <div class="subtask-controls">
                                                            <input type="checkbox"
                                                                   disabled="@(subtask.Status == "Ikke startet")"
                                                                   checked="@(subtask.Status == "Fuldført")"
                                                                   @onchange="e => ToggleSubtaskCompletion(plan, goal, subtask, (bool)e.Value)"/>
                                                            @if (subtask.Status == "Ikke startet")
                                                            {
                                                                <button class="start-btn" @onclick="() => StartSubtask(plan, subtask)">
                                                                    <i class="bi bi-play-fill"></i>
                                                                    Start
                                                                </button>
                                                            }
                                                        </div>
                                                        
                                                        <div class="subtask-content">
                                                            <span class="subtask-text">@subtask.Text</span>
                                                            <div class="subtask-meta">
                                                                @if (subtask.Status == "Ikke startet")
                                                                {
                                                                    <span class="subtask-status not-started">
                                                                        <i class="bi bi-circle"></i>
                                                                        Ikke startet
                                                                    </span>
                                                                }
                                                                else if (subtask.Status == "I gang")
                                                                {
                                                                    <span class="subtask-status in-progress">
                                                                        <i class="bi bi-arrow-clockwise"></i>
                                                                        I gang
                                                                    </span>
                                                                }
                                                                else if (subtask.Status == "Fuldført")
                                                                {
                                                                    <span class="subtask-status completed">
                                                                        <i class="bi bi-check-circle-fill"></i>
                                                                        Fuldført
                                                                    </span>
                                                                }

                                                                @if (subtask.IsRequestedCompleted && subtask.Status != "Fuldført")
                                                                {
                                                                    <span class="subtask-status requested">
                                                                        <i class="bi bi-clock-history"></i>
                                                                        Anmodet
                                                                    </span>
                                                                }
                                                            </div>
                                                        </div>

                                                        @if (allMaterials.Any(m => m.SubtaskId == subtask.Id))
                                                        {
                                                            <button class="material-btn" @onclick="@(() => Nav.NavigateTo($"/learningmaterials?subtaskId={subtask.Id}"))">
                                                                <i class="bi bi-book"></i>
                                                                Materiale
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- School Periods Section -->
                    <div class="section-container">
                        <div class="section-header">
                            <h4>
                                <i class="bi bi-building"></i>
                                Skoleperioder
                            </h4>
                        </div>
                        
                        <div class="school-periods-grid">
                            @foreach (var school in plan.SchoolPeriods)
                            {
                                <div class="school-period-card @(school.Status.ToLower().Replace(" ", "-"))">
                                    <div class="period-header">
                                        <h5 class="period-title">
                                            <i class="bi bi-mortarboard"></i>
                                            @school.Title
                                        </h5>
                                        <div class="period-status">
                                            @if (school.Status == "Ikke startet")
                                            {
                                                <span class="status-badge not-started">
                                                    <i class="bi bi-hourglass"></i>
                                                    Ikke startet
                                                </span>
                                            }
                                            else if (school.Status == "I gang")
                                            {
                                                <span class="status-badge in-progress">
                                                    <i class="bi bi-play-circle"></i>
                                                    I gang
                                                </span>
                                            }
                                            else if (school.Status == "Fuldført")
                                            {
                                                <span class="status-badge completed">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    Fuldført
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <div class="period-details">
                                        @if (school.StartDate.HasValue && school.IsDateConfirmed)
                                        {
                                            var start = school.StartDate.Value;
                                            var end = start.AddDays(7 * school.DurationWeeks);
                                            <div class="period-dates">
                                                <i class="bi bi-calendar-check"></i>
                                                <span><strong>Dato:</strong> @start.ToString("dd.MM.yyyy") - @end.ToString("dd.MM.yyyy")</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="period-dates pending">
                                                <i class="bi bi-calendar-x"></i>
                                                <span>Dato ikke valgt endnu</span>
                                            </div>
                                        }

                                        <div class="period-duration">
                                            <i class="bi bi-clock"></i>
                                            <span><strong>Varighed:</strong> @school.DurationWeeks uger</span>
                                        </div>

                                        @if (school.IsApproved)
                                        {
                                            <div class="approval-status">
                                                <i class="bi bi-patch-check-fill"></i>
                                                <span>Godkendt af køkkenchef</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Notes Section -->
                    <div class="section-container">
                        <button class="section-toggle @(openNotePlanIds.Contains(plan.Id) ? "expanded" : "")" @onclick="() => ToggleNotes(plan.Id)">
                            <i class="bi bi-chevron-right"></i>
                            <span>
                                <i class="bi bi-journal-text"></i>
                                Noter (@plan.Notes.Count)
                            </span>
                        </button>

                        @if (openNotePlanIds.Contains(plan.Id))
                        {
                            <div class="notes-section">
                                @if (plan.Notes.Any())
                                {
                                    <div class="notes-list">
                                        @foreach (var note in plan.Notes)
                                        {
                                            <div class="note-item">
                                                <div class="note-header">
                                                    <i class="bi bi-sticky"></i>
                                                    <span class="note-date">@note.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                                </div>
                                                <div class="note-content">@note.Text</div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="no-notes">
                                        <i class="bi bi-journal"></i>
                                        <p>Ingen noter endnu</p>
                                    </div>
                                }

                                <div class="add-note-section">
                                    @if (addingNoteForPlanId == plan.Id)
                                    {
                                        <div class="note-form">
                                            <textarea class="note-input" 
                                                      placeholder="Skriv din note her..."
                                                      @bind="newNoteTexts[plan.Id]"></textarea>
                                            <div class="note-actions">
                                                <button class="btn-cancel" @onclick="() => CancelAddNote(plan.Id)">
                                                    <i class="bi bi-x-lg"></i>
                                                    Annuller
                                                </button>
                                                <button class="btn-primary" @onclick="() => SaveNote(plan)">
                                                    <i class="bi bi-check-lg"></i>
                                                    Gem note
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="add-note-btn" @onclick="() => StartAddingNote(plan.Id)">
                                            <i class="bi bi-plus-circle"></i>
                                            Tilføj note
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private List<StudentPlan> plans = new(); // Liste over alle elevens planer
    private List<Template> templates = new(); // Liste over alle skabeloner
    private List<LearningMaterial> allMaterials = new(); // Liste over alt læringsmateriale tilknyttet delmål
    private User? currentUser; // Den aktuelt loggede bruger (eleven)
    
    // UI – styrer hvad der er foldet ud
    private HashSet<int> openPlanIds = new();               // Åbne planer (for visning af mål)
    private HashSet<int> openGoalIds = new();               // Åbne mål (for visning af delmål)
    private HashSet<int> openNotePlanIds = new();           // Åbne noter for en plan
    private int addingNoteForPlanId = -1;                   // ID på plan hvor man er ved at tilføje note
    private Dictionary<int, string> newNoteTexts = new();   // Tekst-input til nye noter

    // Formål: Initialiserer siden. Tjekker om brugeren er elev, og henter brugerdata og elevplaner.
    protected override async Task OnInitializedAsync()
    {
        currentUser = await UserService.GetCurrentUserAsync();
        if (currentUser?.Role != "Elev")
        {
            Nav.NavigateTo("/");
            return;
        }

        await LoadData();
    }

    // Formål: Henter elevens planer, læringsmaterialer og skabeloner fra backend.
    private async Task LoadData()
    {
        if (currentUser == null) return;
        
        plans = await StudentPlanService.GetPlansByUserAsync(currentUser);
        allMaterials = await MaterialService.GetAllAsync();
        templates = await TemplateService.GetAllTemplatesAsync();
    }

    // Nye metoder til dashboard statistikker
    private int GetTotalGoals()
    {
        return plans?.Sum(p => p.Goals.Count) ?? 0;
    }

    private int GetCompletedGoalsPercentage()
    {
        var totalGoals = GetTotalGoals();
        if (totalGoals == 0) return 0;
        
        var completedGoals = plans?.Sum(p => p.Goals.Count(g => g.Status == "Fuldført")) ?? 0;
        return (int)Math.Round((double)completedGoals / totalGoals * 100);
    }

    private int GetPlanProgressPercentage(StudentPlan plan)
    {
        var totalSubtasks = plan.Goals.Sum(g => g.Subtasks.Count);
        if (totalSubtasks == 0) return 0;
        
        var completedSubtasks = plan.Goals.Sum(g => g.Subtasks.Count(s => s.Status == "Fuldført"));
        return (int)Math.Round((double)completedSubtasks / totalSubtasks * 100);
    }

    // Parametre: planId – ID på planen der foldes ud/skjules.
    // Formål: Fold-ud/fold-ind funktion for visning af mål under en plan.
    private void TogglePlan(int planId)
    {
        if (!openPlanIds.Add(planId))
            openPlanIds.Remove(planId);
    }

    // Parametre: goalId – ID på målet der foldes ud/skjules.
    // Formål: Fold-ud/fold-ind funktion for visning af delmål under et mål.
    private void ToggleGoal(int goalId)
    {
        if (!openGoalIds.Add(goalId))
            openGoalIds.Remove(goalId);
    }

    // Parametre: planId – ID på planen hvor noter skal vises/skjules.
    // Formål: Fold-ud/fold-ind funktion for visning af noter for en plan.
    private void ToggleNotes(int planId)
    {
        if (!openNotePlanIds.Add(planId))
            openNotePlanIds.Remove(planId);
    }

    // Parametre:
    //   plan – Den plan delmålet hører til.
    //   goal – Målet som delmålet hører til.
    //   subtask – Det delmål der toggles.
    //   isCompleted – True hvis delmålet er fuldført, ellers false.
    // Formål: Skifter status på et delmål og opdaterer målets status baseret på delmålenes tilstand.
    private async Task ToggleSubtaskCompletion(StudentPlan plan, Goal goal, Subtask subtask, bool isCompleted)
    {
        subtask.Status = isCompleted ? "Fuldført" : "I gang";

        // Opdater status for hele målet baseret på subtasks
        if (goal.Subtasks.All(s => s.Status == "Fuldført"))
        {
            goal.Status = "Fuldført";
        }
        else if (goal.Subtasks.Any(s => s.Status == "I gang" || s.Status == "Fuldført"))
        {
            goal.Status = "I gang";
        }
        else
        {
            goal.Status = "Ikke startet";
        }

        await StudentPlanService.UpdateStudentPlanAsync(plan);
        await LoadData();
    }

    // Parametre:
    //   plan – Den plan delmålet hører til.
    //   subtask – Det delmål der startes.
    // Formål: Skifter status på et delmål fra "Ikke startet" til "I gang".
    private async Task StartSubtask(StudentPlan plan, Subtask subtask)
    {
        subtask.Status = "I gang";
        await StudentPlanService.UpdateStudentPlanAsync(plan);
        await LoadData();
    }

    // Parametre: planId – ID på den plan hvor der skal tilføjes en note.
    // Formål: Starter processen med at tilføje en ny note til planen.
    private void StartAddingNote(int planId)
    {
        addingNoteForPlanId = planId;
        if (!newNoteTexts.ContainsKey(planId))
        {
            newNoteTexts[planId] = "";
        }
    }

    // Parametre: planId – ID på den plan hvor tilføjelse af note annulleres.
    // Formål: Annullerer tilføjelse af ny note.
    private void CancelAddNote(int planId)
    {
        addingNoteForPlanId = -1;
        if (newNoteTexts.ContainsKey(planId))
        {
            newNoteTexts[planId] = "";
        }
    }

    // Parametre: plan – Den plan hvor noten skal gemmes.
    // Formål: Gemmer en ny note til planen og opdaterer databasen.
    private async Task SaveNote(StudentPlan plan)
    {
        var noteText = newNoteTexts.GetValueOrDefault(plan.Id, "").Trim();
        if (string.IsNullOrEmpty(noteText))
        {
            return;
        }

        var note = new Note
        {
            Text = noteText,
            CreatedAt = DateTime.Now
        };

        plan.Notes.Add(note);
        await StudentPlanService.UpdateStudentPlanAsync(plan);

        // Reset UI
        addingNoteForPlanId = -1;
        newNoteTexts[plan.Id] = "";
        
        await LoadData();
    }

    // Legacy metode - bruges stadig af komponenter
    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Fuldført" => "bg-success",
            "I gang" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }
}
