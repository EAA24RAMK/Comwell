@page "/"
@inject WebApp.Services.IUserService UserService
@inject WebApp.Services.IStudentPlanService StudentPlanService
@inject WebApp.Services.IPostService PostService
@using Core.Models

@if (!isLoggedIn)
{
    <!-- Not logged in state -->
    <div class="welcome-hero">
        <div class="hero-content">
            <div class="hero-icon">
                <i class="bi bi-mortarboard"></i>
            </div>
            <h1 class="hero-title">Velkommen til Comwell Træningsportal</h1>
            <p class="hero-subtitle">Log venligst ind for at tilgå din personlige læringsportal</p>
            <div class="hero-action">
                <a href="/login" class="login-cta">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Log ind
                </a>
            </div>
        </div>
    </div>
}
else
{
    <!-- Logged in dashboard -->
    <div class="dashboard">
        <!-- Welcome Section -->
        <div class="welcome-section">
            <div class="welcome-content">
                <h1 class="page-title">
                    <i class="bi bi-house-door"></i>
                    Oversigt
                </h1>
                <p class="welcome-text">Velkommer tilbage, <strong>@currentUser?.Name</strong>. Her er din samlede oversigt.</p>
            </div>
            <div class="welcome-stats">
                <div class="stat-item">
                    <div class="stat-number">@goals.Count()</div>
                    <div class="stat-label">Mål i alt</div>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                    <div class="stat-number">@goals.Count(g => g.Status == "Fuldført")</div>
                    <div class="stat-label">Fuldført</div>
                </div>
            </div>
        </div>

        <!-- Main Dashboard Grid -->
        <div class="dashboard-grid">
            <!-- Goals Overview -->
            <div class="dashboard-section goals-section">
                <div class="section-header">
                    <h2>
                        <i class="bi bi-target"></i>
                        Dine mål
                    </h2>
                </div>
                
                <div class="goals-grid">
                    <div class="goal-card total">
                        <div class="goal-icon">
                            <i class="bi bi-bar-chart-line"></i>
                        </div>
                        <div class="goal-content">
                            <div class="goal-value">@goals.Count()</div>
                            <div class="goal-label">Mål i alt</div>
                        </div>
                    </div>

                    <div class="goal-card completed">
                        <div class="goal-icon">
                            <i class="bi bi-check-circle"></i>
                        </div>
                        <div class="goal-content">
                            <div class="goal-value">@goals.Count(g => g.Status == "Fuldført")</div>
                            <div class="goal-label">Fuldført</div>
                        </div>
                    </div>

                    <div class="goal-card in-progress">
                        <div class="goal-icon">
                            <i class="bi bi-arrow-clockwise"></i>
                        </div>
                        <div class="goal-content">
                            <div class="goal-value">@goals.Count(g => g.Status == "I gang")</div>
                            <div class="goal-label">I gang</div>
                        </div>
                    </div>

                    <div class="goal-card attention">
                        <div class="goal-icon">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                        <div class="goal-content">
                            <div class="goal-value">@goals.Count(g => g.Status == "Vær opmærksom på")</div>
                            <div class="goal-label">Vær opmærksom på</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Posts -->
            <div class="dashboard-section posts-section">
                <div class="section-header">
                    <h2>
                        <i class="bi bi-chat-left-text"></i>
                        Seneste opslag
                    </h2>
                    <a href="/posts" class="view-all-link">
                        Se alle
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                <div class="posts-list">
                    @if (recentPosts.Any())
                    {
                        @foreach (var post in recentPosts)
                        {
                            <div class="post-item">
                                <div class="post-icon">
                                    <i class="bi bi-file-text"></i>
                                </div>
                                <div class="post-content">
                                    <div class="post-title">@post.Title</div>
                                    <div class="post-snippet">
                                        @post.Content?.Substring(0, Math.Min(100, post.Content.Length))@(post.Content?.Length > 100 ? "..." : "")
                                    </div>
                                </div>
                                <div class="post-action">
                                    <i class="bi bi-chevron-right"></i>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-chat-left-text"></i>
                            <p>Ingen opslag fundet</p>
                        </div>
                    }
                </div>
            </div>

            <!-- External Links -->
            <div class="dashboard-section links-section">
                <div class="section-header">
                    <h2>
                        <i class="bi bi-box-arrow-up-right"></i>
                        Andre læringsportaler
                    </h2>
                </div>

                <div class="links-grid">
                    <a href="#" class="link-card">
                        <div class="link-icon">
                            <i class="bi bi-journal-code"></i>
                        </div>
                        <div class="link-content">
                            <div class="link-title">Læringsportal A</div>
                            <div class="link-description">Eksterne kurser og materialer</div>
                        </div>
                        <div class="link-arrow">
                            <i class="bi bi-arrow-up-right"></i>
                        </div>
                    </a>

                    <a href="#" class="link-card">
                        <div class="link-icon">
                            <i class="bi bi-globe2"></i>
                        </div>
                        <div class="link-content">
                            <div class="link-title">Læringsportal B</div>
                            <div class="link-description">Online træningsmoduler</div>
                        </div>
                        <div class="link-arrow">
                            <i class="bi bi-arrow-up-right"></i>
                        </div>
                    </a>

                    <a href="#" class="link-card">
                        <div class="link-icon">
                            <i class="bi bi-mortarboard"></i>
                        </div>
                        <div class="link-content">
                            <div class="link-title">Læringsportal C</div>
                            <div class="link-description">Certificeringer og examiner</div>
                        </div>
                        <div class="link-arrow">
                            <i class="bi bi-arrow-up-right"></i>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private User? currentUser;
    private List<Goal> goals = new();
    private bool isLoggedIn = false;
    private List<Post> recentPosts = new();

    protected override async Task OnInitializedAsync()
    {
        currentUser = await UserService.GetCurrentUserAsync();
        await LoadGoals();
        await LoadRecentPosts();
    }

    private async Task LoadGoals()
    {
        if (currentUser != null)
        {
            isLoggedIn = true;
            var plans = await StudentPlanService.GetPlansByUserAsync(currentUser);
            goals = plans.SelectMany(p => p.Goals).ToList();
        }
    }

    private async Task LoadRecentPosts()
    {
        var allPosts = await PostService.GetAllPostsAsync();
        recentPosts = allPosts
            .OrderByDescending(p => p.Id)
            .Take(3)
            .ToList();
    }
}