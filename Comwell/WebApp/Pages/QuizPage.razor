@page "/quiz"
@using WebApp.Services
@using Core.Models
@inject IUserService UserService
@inject IQuizService QuizService
@inject NavigationManager Navigation

@if (currentUser == null)
{
    <p><strong>Du skal være logget ind for at bruge quiz-funktionen.</strong></p>
}
else
{
    <div class="quiz-container">
        <div class="quiz-header">
            <div class="header-content">
                <div class="header-text">
                    <h3>🎯 Quiz Center</h3>
                    <p>Test din viden og konkurrér med dine kolleger!</p>
                </div>
                @if (CanCreateQuiz)
                {
                    <div class="header-actions">
                        <button class="btn btn-primary create-quiz-btn" @onclick="NavigateToCreateQuiz">
                            <i class="bi bi-plus-circle"></i> Opret Quiz
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="tab-navigation">
            <button class="tab-button @(activeTab == "quizzes" ? "active" : "")" @onclick='() => SetActiveTab("quizzes")'>
                Tilgængelige Quizzes
            </button>
            <button class="tab-button @(activeTab == "leaderboard" ? "active" : "")" @onclick='() => SetActiveTab("leaderboard")'>
                Topresultater
            </button>
            <button class="tab-button @(activeTab == "achievements" ? "active" : "")" @onclick='() => SetActiveTab("achievements")'>
                Mine Præstationer
            </button>
            <button class="tab-button @(activeTab == "myresults" ? "active" : "")" @onclick='() => SetActiveTab("myresults")'>
                Mine Resultater
            </button>
        </div>

        <!-- Quiz List Tab -->
        @if (activeTab == "quizzes")
        {
            <div class="quiz-list">
                @if (quizzes.Any())
                {
                    @foreach (var quiz in quizzes)
                    {
                        <div class="quiz-card">
                            <div class="quiz-info">
                                <h4>@quiz.Title</h4>
                                <p class="quiz-description">@quiz.Description</p>
                                <div class="quiz-meta">
                                    <span class="difficulty difficulty-@quiz.Difficulty.ToLower()">@quiz.Difficulty</span>
                                    <span class="questions-count">@quiz.Questions.Count spørgsmål</span>
                                    <span class="time-limit">⏱️ @quiz.TimeLimitMinutes min</span>
                                </div>
                            </div>
                            <div class="quiz-actions">
                                <button class="start-quiz-button" @onclick="() => StartQuiz(quiz.Id)">
                                    Start Quiz
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="no-content">Ingen quizzes tilgængelige endnu.</p>
                }
            </div>
        }

        <!-- Leaderboard Tab -->
        @if (activeTab == "leaderboard")
        {
            <div class="leaderboard">
                <h4>🏆 Topresultater - Alle Quizzes</h4>
                @if (leaderboard.Any())
                {
                    <div class="leaderboard-list">
                        @for (int i = 0; i < leaderboard.Count; i++)
                        {
                            var attempt = leaderboard[i];
                            var user = allUsers.FirstOrDefault(u => u.Id == attempt.UserId);
                            var quiz = quizzes.FirstOrDefault(q => q.Id == attempt.QuizId);
                            
                            <div class="leaderboard-item">
                                <div class="rank">
                                    @if (i == 0) { <span class="gold">🥇</span> }
                                    else if (i == 1) { <span class="silver">🥈</span> }
                                    else if (i == 2) { <span class="bronze">🥉</span> }
                                    else { <span class="rank-number">@(i + 1)</span> }
                                </div>
                                <div class="user-info">
                                    <strong>@(user?.Name ?? "Ukendt")</strong>
                                    <span class="quiz-name">@(quiz?.Title ?? "Ukendt Quiz")</span>
                                </div>
                                <div class="score">
                                    <span class="percentage">@attempt.Percentage.ToString("F1")%</span>
                                    <span class="points">@attempt.Score/@attempt.MaxScore point</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="no-content">Ingen resultater endnu.</p>
                }
            </div>
        }

        <!-- Achievements Tab -->
        @if (activeTab == "achievements")
        {
            <div class="achievements">
                <h4>🏅 Mine Præstationer</h4>
                <div class="achievements-grid">
                    @foreach (var achievement in allAchievements)
                    {
                        var isEarned = userAchievements.Any(ua => ua.AchievementId == achievement.Id);
                        <div class="achievement-card @(isEarned ? "earned" : "locked")">
                            <div class="achievement-icon">@achievement.Icon</div>
                            <div class="achievement-info">
                                <h5>@achievement.Name</h5>
                                <p>@achievement.Description</p>
                                <small>@achievement.Requirements</small>
                            </div>
                            @if (isEarned)
                            {
                                var earnedDate = userAchievements.First(ua => ua.AchievementId == achievement.Id).EarnedAt;
                                <div class="earned-date">
                                    Opnået @earnedDate.ToString("dd/MM/yyyy")
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <!-- My Results Tab -->
        @if (activeTab == "myresults")
        {
            <div class="my-results">
                <h4>📊 Mine Resultater</h4>
                @if (userAttempts.Any())
                {
                    <div class="stats-overview">
                        <div class="stat-card">
                            <span class="stat-value">@userAttempts.Count</span>
                            <span class="stat-label">Gennemførte Quizzes</span>
                        </div>
                        <div class="stat-card">
                            <span class="stat-value">@userAttempts.Average(a => a.Percentage).ToString("F1")%</span>
                            <span class="stat-label">Gennemsnitlig Score</span>
                        </div>
                        <div class="stat-card">
                            <span class="stat-value">@userAttempts.Max(a => a.Percentage).ToString("F1")%</span>
                            <span class="stat-label">Bedste Score</span>
                        </div>
                    </div>

                    <div class="results-list">
                        @foreach (var attempt in userAttempts.OrderByDescending(a => a.CompletedAt))
                        {
                            var quiz = quizzes.FirstOrDefault(q => q.Id == attempt.QuizId);
                            <div class="result-item">
                                <div class="result-info">
                                    <h5>@(quiz?.Title ?? "Ukendt Quiz")</h5>
                                    <span class="completion-date">@attempt.CompletedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div class="result-score">
                                    <span class="percentage">@attempt.Percentage.ToString("F1")%</span>
                                    <span class="points">@attempt.Score/@attempt.MaxScore</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="no-content">Du har ikke gennemført nogen quizzes endnu.</p>
                }
            </div>
        }
    </div>
}

@code {
    private List<Quiz> quizzes = new();
    private List<QuizAttempt> leaderboard = new();
    private List<Achievement> allAchievements = new();
    private List<UserAchievement> userAchievements = new();
    private List<QuizAttempt> userAttempts = new();
    private List<User> allUsers = new();
    private User? currentUser;
    private string activeTab = "quizzes";
    
    private bool CanCreateQuiz => currentUser?.Role == "HR" || currentUser?.Role == "Køkkenchef" || currentUser?.Role == "Kok";

    protected override async Task OnInitializedAsync()
    {
        currentUser = await UserService.GetCurrentUserAsync();
        if (currentUser != null)
        {
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        quizzes = await QuizService.GetAllQuizzesAsync();
        leaderboard = await QuizService.GetLeaderboardAsync();
        allAchievements = await QuizService.GetAllAchievementsAsync();
        userAchievements = await QuizService.GetUserAchievementsAsync(currentUser!.Id);
        userAttempts = await QuizService.GetUserAttemptsAsync(currentUser!.Id);
        allUsers = await UserService.GetAllUsersAsync();
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
    }

    private async Task StartQuiz(int quizId)
    {
        if (currentUser != null)
        {
            var attempt = await QuizService.StartQuizAsync(quizId, currentUser.Id);
            Navigation.NavigateTo($"/quiz/take/{attempt.Id}");
        }
    }
    
    private void NavigateToCreateQuiz()
    {
        Navigation.NavigateTo("/quiz/create");
    }
} 