@page "/quiz"
@attribute [Authorize]
@using WebApp.Services
@using Core.Models
@inject IUserService UserService
@inject IQuizService QuizService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

@if (currentUser == null)
{
    <div class="dashboard-container">
        <div class="empty-state">
            <div class="empty-icon">
                <i class="bi bi-lock"></i>
            </div>
            <h4>Adgang krævet</h4>
            <p>Du skal være logget ind for at bruge quiz-funktionen.</p>
            <a href="/login" class="btn-create">
                <i class="bi bi-box-arrow-in-right me-2"></i>
                Log ind
            </a>
        </div>
    </div>
}
else
{
    <div class="dashboard-container">
        <!-- Page Header -->
        <div class="page-header">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="bi bi-patch-question me-3"></i>
                    Quiz Center
                </h1>
                <p class="page-description">Test din viden og konkurrér med dine kolleger!</p>
            </div>
            
            @if (CanCreateQuiz)
            {
                <div class="page-actions">
                    <button class="btn-create" @onclick="OpenCreateQuizModal">
                        <i class="bi bi-plus-circle me-2"></i>
                        Opret Quiz
                    </button>
                </div>
            }
        </div>

        <!-- Stats Section -->
        <div class="stats-grid">
            <div class="stat-card quizzes">
                <div class="stat-icon">
                    <i class="bi bi-patch-question-fill"></i>
                </div>
                <div class="stat-info">
                    <div class="stat-number">@quizzes.Count</div>
                    <div class="stat-label">Tilgængelige quizzes</div>
                </div>
            </div>
            
            <div class="stat-card completed">
                <div class="stat-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div class="stat-info">
                    <div class="stat-number">@userAttempts.Count</div>
                    <div class="stat-label">Mine forsøg</div>
                </div>
            </div>
            
            <div class="stat-card leaderboard">
                <div class="stat-icon">
                    <i class="bi bi-trophy-fill"></i>
                </div>
                <div class="stat-info">
                    <div class="stat-number">@leaderboard.Count</div>
                    <div class="stat-label">Topresultater</div>
                </div>
            </div>
            
            <div class="stat-card achievements">
                <div class="stat-icon">
                    <i class="bi bi-award-fill"></i>
                </div>
                <div class="stat-info">
                    <div class="stat-number">@userAchievements.Count</div>
                    <div class="stat-label">Præstationer</div>
                </div>
            </div>
        </div>

        <!-- Tab Navigation -->
        <div class="filters-section">
            <div class="filters-header">
                <h3 class="filters-title">
                    <i class="bi bi-layers me-2"></i>
                    Quiz kategorier
                </h3>
            </div>
            <div class="filters-content">
                <div class="tab-buttons">
                    <button class="filter-tab @(activeTab == "quizzes" ? "active" : "")" @onclick='() => SetActiveTab("quizzes")'>
                        <i class="bi bi-collection me-2"></i>
                        Tilgængelige Quizzes
                    </button>
                    <button class="filter-tab @(activeTab == "leaderboard" ? "active" : "")" @onclick='() => SetActiveTab("leaderboard")'>
                        <i class="bi bi-trophy me-2"></i>
                        Topresultater
                    </button>
                    <button class="filter-tab @(activeTab == "achievements" ? "active" : "")" @onclick='() => SetActiveTab("achievements")'>
                        <i class="bi bi-award me-2"></i>
                        Mine Præstationer
                    </button>
                    <button class="filter-tab @(activeTab == "myresults" ? "active" : "")" @onclick='() => SetActiveTab("myresults")'>
                        <i class="bi bi-graph-up me-2"></i>
                        Mine Resultater
                    </button>
                </div>
            </div>
        </div>

        <!-- Content Section -->
        <div class="content-section">
            <div class="section-header">
                <h3 class="section-title">
                    @if (activeTab == "quizzes")
                    {
                        <i class="bi bi-collection me-2"></i>
                        <text>Tilgængelige Quizzes</text>
                    }
                    else if (activeTab == "leaderboard")
                    {
                        <i class="bi bi-trophy me-2"></i>
                        <text>Topresultater</text>
                    }
                    else if (activeTab == "achievements")
                    {
                        <i class="bi bi-award me-2"></i>
                        <text>Mine Præstationer</text>
                    }
                    else if (activeTab == "myresults")
                    {
                        <i class="bi bi-graph-up me-2"></i>
                        <text>Mine Resultater</text>
                    }
                </h3>
            </div>

            <!-- Quiz List Tab -->
            @if (activeTab == "quizzes")
            {
                @if (quizzes.Any())
                {
                    <div class="materials-grid">
                        @foreach (var quiz in quizzes)
                        {
                            <div class="material-card">
                                <div class="material-header">
                                    <div class="material-type-icon">
                                        <i class="bi bi-patch-question-fill"></i>
                                    </div>
                                    <div class="material-info">
                                        <h5 class="material-title">@quiz.Title</h5>
                                        <div class="material-metadata">
                                            <span class="material-subtask">
                                                <i class="bi bi-speedometer2 me-1"></i>
                                                @quiz.Difficulty
                                            </span>
                                            <span class="material-date">
                                                <i class="bi bi-clock me-1"></i>
                                                @quiz.TimeLimitMinutes min
                                            </span>
                                            <span class="material-date">
                                                <i class="bi bi-patch-question me-1"></i>
                                                @quiz.Questions.Count spørgsmål
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="material-content">
                                    <div class="quiz-description">@quiz.Description</div>
                                </div>

                                <div class="material-footer">
                                    <button class="btn-access" @onclick="() => StartQuiz(quiz.Id)">
                                        <i class="bi bi-play-circle me-2"></i>
                                        Start Quiz
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="bi bi-patch-question"></i>
                        </div>
                        <h4>Ingen quizzes tilgængelige</h4>
                        <p>Der er ingen quizzes at tage endnu.</p>
                        @if (CanCreateQuiz)
                        {
                            <button class="btn-create" @onclick="OpenCreateQuizModal">
                                <i class="bi bi-plus-circle me-2"></i>
                                Opret første quiz
                            </button>
                        }
                    </div>
                }
            }

            <!-- Leaderboard Tab -->
            @if (activeTab == "leaderboard")
            {
                @if (leaderboard.Any())
                {
                    <div class="materials-grid">
                        @for (int i = 0; i < leaderboard.Count; i++)
                        {
                            var attempt = leaderboard[i];
                            var user = allUsers.FirstOrDefault(u => u.Id == attempt.UserId);
                            var quiz = quizzes.FirstOrDefault(q => q.Id == attempt.QuizId);
                            
                            <div class="material-card">
                                <div class="material-header">
                                    <div class="material-type-icon @GetRankClass(i)">
                                        @if (i == 0) 
                                        { 
                                            <i class="bi bi-trophy-fill"></i>
                                        }
                                        else if (i == 1) 
                                        { 
                                            <i class="bi bi-award-fill"></i>
                                        }
                                        else if (i == 2) 
                                        { 
                                            <i class="bi bi-award"></i>
                                        }
                                        else 
                                        { 
                                            <span>@(i + 1)</span>
                                        }
                                    </div>
                                    <div class="material-info">
                                        <h5 class="material-title">@(user?.Name ?? "Ukendt")</h5>
                                        <div class="material-metadata">
                                            <span class="material-subtask">
                                                <i class="bi bi-patch-question me-1"></i>
                                                @(quiz?.Title ?? "Ukendt Quiz")
                                            </span>
                                            <span class="material-date">
                                                <i class="bi bi-percent me-1"></i>
                                                @attempt.Percentage.ToString("F1")%
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="material-content">
                                    <div class="score-display">
                                        <span class="score-text">@attempt.Score af @attempt.MaxScore point</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="bi bi-trophy"></i>
                        </div>
                        <h4>Ingen resultater endnu</h4>
                        <p>Der er ingen quiz-resultater at vise endnu.</p>
                    </div>
                }
            }

            <!-- Achievements Tab -->
            @if (activeTab == "achievements")
            {
                @if (allAchievements.Any())
                {
                    <div class="materials-grid">
                        @foreach (var achievement in allAchievements)
                        {
                            var isEarned = userAchievements.Any(ua => ua.AchievementId == achievement.Id);
                            <div class="material-card @(isEarned ? "earned" : "locked")">
                                <div class="material-header">
                                    <div class="material-type-icon">
                                        <i class="bi bi-@(isEarned ? "award-fill" : "lock")"></i>
                                    </div>
                                    <div class="material-info">
                                        <h5 class="material-title">@achievement.Name</h5>
                                        <div class="material-metadata">
                                            <span class="material-subtask">
                                                <i class="bi bi-@(isEarned ? "check-circle" : "x-circle") me-1"></i>
                                                @(isEarned ? "Opnået" : "Låst")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="material-content">
                                    <div class="achievement-description">@achievement.Description</div>
                                    @if (!isEarned)
                                    {
                                        <div class="achievement-requirements">@achievement.Requirements</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="bi bi-award"></i>
                        </div>
                        <h4>Ingen præstationer</h4>
                        <p>Der er ingen præstationer defineret endnu.</p>
                    </div>
                }
            }

            <!-- My Results Tab -->
            @if (activeTab == "myresults")
            {
                @if (userAttempts.Any())
                {
                    <div class="materials-grid">
                        @foreach (var attempt in userAttempts.OrderByDescending(a => a.Id))
                        {
                            var quiz = quizzes.FirstOrDefault(q => q.Id == attempt.QuizId);
                            
                            <div class="material-card">
                                <div class="material-header">
                                    <div class="material-type-icon">
                                        <i class="bi bi-graph-up"></i>
                                    </div>
                                    <div class="material-info">
                                        <h5 class="material-title">@(quiz?.Title ?? "Ukendt Quiz")</h5>
                                        <div class="material-metadata">
                                            <span class="material-subtask">
                                                <i class="bi bi-calendar me-1"></i>
                                                @attempt.CompletedAt?.ToString("dd MMM yyyy")
                                            </span>
                                            <span class="material-date">
                                                <i class="bi bi-percent me-1"></i>
                                                @attempt.Percentage.ToString("F1")%
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="material-content">
                                    <div class="score-display">
                                        <span class="score-text">@attempt.Score af @attempt.MaxScore point</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="bi bi-graph-up"></i>
                        </div>
                        <h4>Ingen resultater endnu</h4>
                        <p>Du har ikke gennemført nogle quizzes endnu.</p>
                    </div>
                }
            }
        </div>
    </div>
}

<!-- Modal for Opret Quiz -->
@if (showCreateQuizModal)
{
    <div class="modal-overlay" @onclick="CloseCreateQuizModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h4 class="modal-title">
                    <i class="bi bi-plus-circle"></i>
                    Opret ny quiz
                </h4>
                <button class="modal-close" @onclick="CloseCreateQuizModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-body">
                <!-- Viser feedbackbesked hvis der er en -->
                @if (!string.IsNullOrEmpty(feedbackMessage))
                {
                    <div class="alert alert-warning">@feedbackMessage</div>
                }

                <!-- Formular til oprettelse af quiz -->
                <EditForm Model="quizModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="validation-summary" />

                    <!-- Quiz grundoplysninger -->
                    <div class="quiz-basic-info">
                        <h5 class="form-section-title">
                            <i class="bi bi-info-circle me-2"></i>
                            Grundoplysninger
                        </h5>
                        
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Titel:</label>
                                <input @bind="quizModel.Title" class="form-input" placeholder="Indtast quiz titel" />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Beskrivelse:</label>
                                <textarea @bind="quizModel.Description" class="form-input" rows="3" placeholder="Indtast quiz beskrivelse"></textarea>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group half">
                                <label class="form-label">Sværhedsgrad:</label>
                                <select @bind="quizModel.Difficulty" class="form-select">
                                    <option value="Easy">Let</option>
                                    <option value="Medium">Mellem</option>
                                    <option value="Hard">Svær</option>
                                </select>
                            </div>
                            <div class="form-group half">
                                <label class="form-label">Tidsbegrænsning (minutter):</label>
                                <input @bind="quizModel.TimeLimitMinutes" type="number" class="form-input" min="1" max="60" />
                            </div>
                        </div>
                    </div>

                    <!-- Spørgsmål sektion -->
                    <div class="quiz-questions-section">
                        <div class="questions-header">
                            <h5 class="form-section-title">
                                <i class="bi bi-patch-question me-2"></i>
                                Spørgsmål (@quizModel.Questions.Count)
                            </h5>
                            <button type="button" class="btn-add-question" @onclick="AddQuestion">
                                <i class="bi bi-plus me-1"></i>
                                Tilføj spørgsmål
                            </button>
                        </div>

                        @if (quizModel.Questions.Any())
                        {
                            @for (int questionIndex = 0; questionIndex < quizModel.Questions.Count; questionIndex++)
                            {
                                var question = quizModel.Questions[questionIndex];
                                var qIndex = questionIndex; // Capture for lambda
                                
                                <div class="question-card">
                                    <div class="question-header">
                                        <h6 class="question-title">Spørgsmål @(qIndex + 1)</h6>
                                        <button type="button" class="btn-remove-question" @onclick="() => RemoveQuestion(qIndex)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <div class="question-content">
                                        <div class="form-row">
                                            <div class="form-group">
                                                <label class="form-label">Spørgsmålstekst:</label>
                                                <input @bind="question.QuestionText" class="form-input" placeholder="Indtast spørgsmål" />
                                            </div>
                                        </div>

                                        <div class="form-row">
                                            <div class="form-group half">
                                                <label class="form-label">Type:</label>
                                                <select @bind="question.QuestionType" @bind:after="() => OnQuestionTypeChanged(qIndex)" class="form-select">
                                                    <option value="MultipleChoice">Multiple Choice</option>
                                                    <option value="TrueFalse">Sand/Falsk</option>
                                                </select>
                                            </div>
                                            <div class="form-group half">
                                                <label class="form-label">Point:</label>
                                                <input @bind="question.Points" type="number" class="form-input" min="1" max="50" />
                                            </div>
                                        </div>

                                        <!-- Svar sektion -->
                                        <div class="answers-section">
                                            <div class="answers-header">
                                                <label class="form-label">Svarmuligheder:</label>
                                                @if (question.QuestionType == "MultipleChoice" && question.Answers.Count < 6)
                                                {
                                                    <button type="button" class="btn-add-answer" @onclick="() => AddAnswer(qIndex)">
                                                        <i class="bi bi-plus me-1"></i>
                                                        Tilføj svar
                                                    </button>
                                                }
                                            </div>

                                            @for (int answerIndex = 0; answerIndex < question.Answers.Count; answerIndex++)
                                            {
                                                var answer = question.Answers[answerIndex];
                                                var aIndex = answerIndex; // Capture for lambda
                                                
                                                <div class="answer-row">
                                                    <div class="answer-correct">
                                                        <input type="radio" 
                                                               name="correct-@qIndex" 
                                                               checked="@answer.IsCorrect" 
                                                               @onchange="() => SetCorrectAnswer(qIndex, aIndex)" />
                                                        <label class="correct-label">Korrekt</label>
                                                    </div>
                                                    <div class="answer-input">
                                                        <input @bind="answer.AnswerText" class="form-input" placeholder="Indtast svar" />
                                                    </div>
                                                    @if (question.QuestionType == "MultipleChoice" && question.Answers.Count > 2)
                                                    {
                                                        <button type="button" class="btn-remove-answer" @onclick="() => RemoveAnswer(qIndex, aIndex)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="no-questions-message">
                                <i class="bi bi-patch-question text-muted"></i>
                                <p>Ingen spørgsmål tilføjet endnu. Klik på "Tilføj spørgsmål" for at komme i gang.</p>
                            </div>
                        }
                    </div>

                    <div class="modal-actions">
                        <button type="button" class="btn-cancel" @onclick="CloseCreateQuizModal">Annuller</button>
                        <button type="submit" class="btn-primary" disabled="@(!IsFormValid)">
                            <i class="bi bi-check-circle me-2"></i>
                            Gem Quiz
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<script>
    window.preventBodyScroll = (prevent) => {
        if (prevent) {
            document.body.style.overflow = 'hidden';
        } else {
            document.body.style.overflow = '';
        }
    };
</script>

@code {
    private List<Quiz> quizzes = new();
    private List<QuizAttempt> leaderboard = new();
    private List<Achievement> allAchievements = new();
    private List<UserAchievement> userAchievements = new();
    private List<QuizAttempt> userAttempts = new();
    private List<User> allUsers = new();
    private User? currentUser;
    private string activeTab = "quizzes";
    
    // Modal – styrer opret quiz modal
    private bool showCreateQuizModal = false;
    private string feedbackMessage = "";
    private Quiz quizModel = new() { 
        Difficulty = "Medium", 
        TimeLimitMinutes = 10,
        IsActive = true,
        Questions = new List<QuizQuestion>()
    };
    
    private bool CanCreateQuiz => currentUser?.Role == "HR" || currentUser?.Role == "Køkkenchef" || currentUser?.Role == "Kok";

    private bool IsFormValid => 
        !string.IsNullOrWhiteSpace(quizModel.Title) && 
        !string.IsNullOrWhiteSpace(quizModel.Description) && 
        quizModel.Questions.Count > 0 &&
        quizModel.Questions.All(q => !string.IsNullOrWhiteSpace(q.QuestionText) && 
                                     q.Answers.Count >= 2 && 
                                     q.Answers.Any(a => a.IsCorrect) &&
                                     q.Answers.All(a => !string.IsNullOrWhiteSpace(a.AnswerText)));

    protected override async Task OnInitializedAsync()
    {
        currentUser = await UserService.GetCurrentUserAsync();
        if (currentUser != null)
        {
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        quizzes = await QuizService.GetAllQuizzesAsync();
        leaderboard = await QuizService.GetLeaderboardAsync();
        allAchievements = await QuizService.GetAllAchievementsAsync();
        userAchievements = await QuizService.GetUserAchievementsAsync(currentUser!.Id);
        userAttempts = await QuizService.GetUserAttemptsAsync(currentUser!.Id);
        allUsers = await UserService.GetAllUsersAsync();
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
    }

    private async Task StartQuiz(int quizId)
    {
        if (currentUser != null)
        {
            var attempt = await QuizService.StartQuizAsync(quizId, currentUser.Id);
            Navigation.NavigateTo($"/quiz/take/{attempt.Id}");
        }
    }
    
    // Modal metoder for Opret Quiz
    private async Task OpenCreateQuizModal()
    {
        showCreateQuizModal = true;
        feedbackMessage = "";
        quizModel = new Quiz { 
            Difficulty = "Medium", 
            TimeLimitMinutes = 10,
            IsActive = true,
            Questions = new List<QuizQuestion>()
        };
        
        // Prevent body scroll
        await JSRuntime.InvokeVoidAsync("preventBodyScroll", true);
    }

    private async Task CloseCreateQuizModal()
    {
        showCreateQuizModal = false;
        feedbackMessage = "";
        quizModel = new Quiz { 
            Difficulty = "Medium", 
            TimeLimitMinutes = 10,
            IsActive = true,
            Questions = new List<QuizQuestion>()
        };
        
        // Restore body scroll
        await JSRuntime.InvokeVoidAsync("preventBodyScroll", false);
    }

    private void AddQuestion()
    {
        var question = new QuizQuestion
        {
            QuestionType = "MultipleChoice",
            Points = 10,
            Answers = new List<QuizAnswer>
            {
                new QuizAnswer { AnswerText = "", IsCorrect = true },
                new QuizAnswer { AnswerText = "", IsCorrect = false },
                new QuizAnswer { AnswerText = "", IsCorrect = false },
                new QuizAnswer { AnswerText = "", IsCorrect = false }
            }
        };
        quizModel.Questions.Add(question);
    }

    private void RemoveQuestion(int questionIndex)
    {
        if (quizModel.Questions.Count > questionIndex)
        {
            quizModel.Questions.RemoveAt(questionIndex);
        }
    }

    private void OnQuestionTypeChanged(int questionIndex)
    {
        var question = quizModel.Questions[questionIndex];
        
        if (question.QuestionType == "TrueFalse")
        {
            question.Answers.Clear();
            question.Answers.Add(new QuizAnswer { AnswerText = "Ja", IsCorrect = true });
            question.Answers.Add(new QuizAnswer { AnswerText = "Nej", IsCorrect = false });
        }
        else if (question.QuestionType == "MultipleChoice" && question.Answers.Count < 2)
        {
            question.Answers.Clear();
            question.Answers.Add(new QuizAnswer { AnswerText = "", IsCorrect = true });
            question.Answers.Add(new QuizAnswer { AnswerText = "", IsCorrect = false });
            question.Answers.Add(new QuizAnswer { AnswerText = "", IsCorrect = false });
            question.Answers.Add(new QuizAnswer { AnswerText = "", IsCorrect = false });
        }
    }

    private void AddAnswer(int questionIndex)
    {
        var question = quizModel.Questions[questionIndex];
        if (question.Answers.Count < 6)
        {
            question.Answers.Add(new QuizAnswer { AnswerText = "", IsCorrect = false });
        }
    }

    private void RemoveAnswer(int questionIndex, int answerIndex)
    {
        var question = quizModel.Questions[questionIndex];
        if (question.Answers.Count > 2)
        {
            question.Answers.RemoveAt(answerIndex);
            
            // Ensure at least one answer is correct
            if (!question.Answers.Any(a => a.IsCorrect) && question.Answers.Any())
            {
                question.Answers[0].IsCorrect = true;
            }
        }
    }

    private void SetCorrectAnswer(int questionIndex, int answerIndex)
    {
        var question = quizModel.Questions[questionIndex];
        for (int i = 0; i < question.Answers.Count; i++)
        {
            question.Answers[i].IsCorrect = i == answerIndex;
        }
    }

    private async Task HandleSubmit()
    {
        if (!IsFormValid)
        {
            if (string.IsNullOrWhiteSpace(quizModel.Title))
                feedbackMessage = "Indtast venligst en titel for quizzen.";
            else if (string.IsNullOrWhiteSpace(quizModel.Description))
                feedbackMessage = "Indtast venligst en beskrivelse for quizzen.";
            else if (quizModel.Questions.Count == 0)
                feedbackMessage = "Tilføj venligst mindst ét spørgsmål.";
            else if (quizModel.Questions.Any(q => string.IsNullOrWhiteSpace(q.QuestionText)))
                feedbackMessage = "Alle spørgsmål skal have en tekst.";
            else if (quizModel.Questions.Any(q => q.Answers.Any(a => string.IsNullOrWhiteSpace(a.AnswerText))))
                feedbackMessage = "Alle svar skal have en tekst.";
            else if (quizModel.Questions.Any(q => !q.Answers.Any(a => a.IsCorrect)))
                feedbackMessage = "Hvert spørgsmål skal have mindst ét korrekt svar.";
            return;
        }

        try
        {
            // Sæt default værdier
            quizModel.CreatedByUserId = currentUser?.Id ?? 1;
            quizModel.CreatedAt = DateTime.Now;
            
            // Opret komplet quiz med spørgsmål og svar
            await QuizService.CreateQuizAsync(quizModel);
            await LoadData();
            CloseCreateQuizModal();
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Fejl ved oprettelse af quiz: {ex.Message}";
        }
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "?";
        
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpper(),
            _ => $"{parts[0][..1]}{parts[^1][..1]}".ToUpper()
        };
    }

    private string GetRankClass(int rank)
    {
        return rank switch
        {
            0 => "gold",
            1 => "silver",
            2 => "bronze",
            _ => "regular"
        };
    }
