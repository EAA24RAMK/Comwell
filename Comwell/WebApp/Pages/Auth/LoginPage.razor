@page "/login"
@using Core.Models
@using WebApp.Services
@inject ILoginService LoginService
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IJSRuntime JSRuntime

<!-- Modern Login Page -->
<div class="login-layout">
    <div class="login-container">
        <!-- Background Pattern -->
        <div class="background-pattern"></div>
        
        <!-- Login Card -->
        <div class="login-card">
            <!-- Header Section -->
            <div class="login-header">
                <div class="brand-section">
                    <div class="brand-icon">
                        <i class="bi bi-mortarboard"></i>
                    </div>
                    <h1 class="brand-title">Comwell</h1>
                    <p class="brand-subtitle">Træningsportal</p>
                </div>
                
                <div class="welcome-section">
                    <h2 class="welcome-title">Velkommen tilbage</h2>
                    <p class="welcome-text">Log ind for at tilgå din læringsportal</p>
                </div>
            </div>

            <!-- Error Message -->
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="error-alert">
                    <i class="bi bi-exclamation-triangle"></i>
                    <span>@ErrorMessage</span>
                </div>
            }

            <!-- Login Form -->
            <EditForm Model="loginModel" OnValidSubmit="HandleLogin" class="login-form">
                <DataAnnotationsValidator/>
                <ValidationSummary class="validation-summary"/>

                <div class="form-group">
                    <label class="form-label">
                        <i class="bi bi-envelope"></i>
                        Email
                    </label>
                    <InputText @bind-Value="loginModel.Email" 
                               placeholder="Indtast din email" 
                               class="form-input"/>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="bi bi-lock"></i>
                        Kodeord
                    </label>
                    <InputText @bind-Value="loginModel.Password" 
                               type="password" 
                               placeholder="Indtast dit kodeord" 
                               class="form-input"/>
                </div>

                <div class="form-options">
                    <label class="checkbox-label">
                        <input type="checkbox" class="checkbox-input" @bind="rememberMe"/>
                        <span class="checkbox-custom"></span>
                        <span class="checkbox-text">Husk mig</span>
                    </label>
                    <a href="#" class="forgot-link">
                        Glemt dit password?
                    </a>
                </div>

                <button type="submit" class="login-button" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <div class="loading-spinner"></div>
                        <span>Logger ind...</span>
                    }
                    else
                    {
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Log ind</span>
                    }
                </button>
            </EditForm>

            <!-- Footer -->
            <div class="login-footer">
                <p>Har du brug for hjælp? <a href="#" class="support-link">Kontakt support</a></p>
            </div>
        </div>
    </div>
</div>

@code {
    private Login loginModel = new();
    private string ErrorMessage = "";
    private bool isLoading = false;
    private bool rememberMe = false;
    
    protected override async Task OnInitializedAsync()
    {
        // Hvis brugeren allerede er logget ind (i localStorage eller sessionStorage), redirect til forsiden
        var user = await LocalStorage.GetItemAsync<User>("loggedInUser");
        if (user == null)
        {
            var userJson = await JSRuntime.InvokeAsync<string>("sessionStorageInterop.getItem", "loggedInUser");
            if (!string.IsNullOrEmpty(userJson))
            {
                user = System.Text.Json.JsonSerializer.Deserialize<User>(userJson);
            }
        }
        if (user != null)
        {
            NavManager.NavigateTo("/", forceLoad: true);
        }
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        ErrorMessage = "";
        StateHasChanged();
        
        try
        {
            var user = await LoginService.LoginAsync(loginModel.Email, loginModel.Password);
            if (user != null)
            {
                if (rememberMe)
                {
                    await LocalStorage.SetItemAsync("loggedInUser", user);
                    // Fjern evt. fra sessionStorage
                    await JSRuntime.InvokeVoidAsync("sessionStorageInterop.removeItem", "loggedInUser");
                }
                else
                {
                    // Gem i sessionStorage (midlertidigt)
                    var userJson = System.Text.Json.JsonSerializer.Serialize(user);
                    await JSRuntime.InvokeVoidAsync("sessionStorageInterop.setItem", "loggedInUser", userJson);
                    // Fjern evt. fra localStorage
                    await LocalStorage.RemoveItemAsync("loggedInUser");
                }
                NavManager.NavigateTo("/", forceLoad: true);
            }
            else
            {
                ErrorMessage = "Forkert email eller kodeord.";
            }
        }
        catch (Exception)
        {
            ErrorMessage = "Der opstod en fejl. Prøv igen senere.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}