@inherits LayoutComponentBase
@inject IUserService UserService
@inject NavigationManager NavManager
@inject INotificationService NotificationService
@inject HttpClient Http
@using Core.Models
@using WebApp.Services
@using System.Timers
@implements IDisposable

<!-- Layout vises kun hvis brugeren ikke er på login-siden -->
@if (!NavManager.Uri.Contains("/login"))
{
    <!-- Floating Navigation -->
    <NavMenu />
    
    <!-- Main Content Area -->
    <main class="main-content">
        <!-- Notification System (moved from old topbar) -->
        <div class="notification-system">
            @if (currentUser != null)
            {
                <div class="notification-container">
                    <button class="notification-btn" @onclick="ToggleNotifications" aria-label="Notifikationer">
                        <i class="bi bi-bell"></i>
                        @if (!hasSeenNotifications && notifications?.Count > 0)
                        {
                            <span class="notification-badge">@notifications.Count</span>
                        }
                    </button>

                    @if (showNotifications)
                    {
                        <div class="notification-dropdown">
                            <div class="notification-header">
                                <h6>Notifikationer</h6>
                                <button class="notification-close" @onclick="() => showNotifications = false">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                            <div class="notification-list">
                                @if (notifications?.Any() == true)
                                {
                                    @foreach (var note in notifications.OrderByDescending(n => n.CreatedAt))
                                    {
                                        <div class="notification-item">
                                            <div class="notification-content">
                                                @if (!string.IsNullOrWhiteSpace(note.Link))
                                                {
                                                    <a href="@note.Link" class="notification-message">@note.Message</a>
                                                }
                                                else
                                                {
                                                    <div class="notification-message">@note.Message</div>
                                                }
                                                <div class="notification-meta">
                                                    Deadline: @note.Deadline.ToShortDateString() | 
                                                    Modtaget: @note.CreatedAt.ToShortDateString()
                                                </div>
                                            </div>
                                            <button class="notification-delete" @onclick="() => DeleteNotification(note.Id)" aria-label="Slet notifikation">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="notification-empty">
                                        <i class="bi bi-bell-slash"></i>
                                        <span>Ingen nye notifikationer</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Page Content -->
        <div class="page-content">
            @Body
        </div>
    </main>
}
else
{
    <!-- Simple layout for login page -->
    <div class="login-layout">
        @Body
    </div>
}

@code {
    private User? currentUser;
    private bool showNotifications = false;
    private List<Notification> notifications = new();
    private bool hasSeenNotifications = false;
    private Timer? notificationTimer;

    protected override async Task OnInitializedAsync()
    {
        currentUser = await UserService.GetCurrentUserAsync();

        if (currentUser != null)
        {
            await LoadNotifications();

            // Start en timer der opdaterer hvert minut (60.000 ms)
            notificationTimer = new Timer(60000);
            notificationTimer.Elapsed += async (_, _) =>
            {
                await InvokeAsync(async () =>
                {
                    await LoadNotifications();
                    StateHasChanged(); // Opdaterer UI med nye notifikationer
                });
            };
            notificationTimer.AutoReset = true;
            notificationTimer.Enabled = true;
        }
    }
    
    private async Task LoadNotifications()
    {
        if (currentUser != null)
        {
            await NotificationService.GenererateNotificationsAsync(); // valgfrit – hvis du vil generere nye
            notifications = await NotificationService.GetNotificationsByUserAsync(currentUser.Id);
        }
    }
    
    public void Dispose()
    {
        notificationTimer?.Stop();
        notificationTimer?.Dispose();
    }

    private async Task ToggleNotifications()
    {
        showNotifications = !showNotifications;

        if (showNotifications && currentUser != null)
        {
            await NotificationService.GenererateNotificationsAsync();
            notifications = await NotificationService.GetNotificationsByUserAsync(currentUser.Id);
            hasSeenNotifications = true;
            StateHasChanged();
        }
    }

    private async Task DeleteNotification(int notificationId)
    {
        if (currentUser == null) return;

        await NotificationService.DeleteNotificationForUserAsync(notificationId, currentUser.Id);
        notifications = await NotificationService.GetNotificationsByUserAsync(currentUser.Id);
        StateHasChanged();
    }
}
