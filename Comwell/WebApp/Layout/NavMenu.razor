@using Core.Models
@using WebApp.Services
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject NavigationManager NavManager
@inject IUserService UserService
@inject IJSRuntime JSRuntime

<!-- Floating Island Navigation -->
<div class="floating-nav">
    <div class="nav-container">
        <!-- Logo/Brand -->
        <div class="nav-brand">
            <a href="" class="brand-link">
                <div class="brand-icon">C</div>
                <span class="brand-text">Comwell</span>
            </a>
        </div>

        <!-- Desktop Navigation Links -->
        <nav class="nav-links" id="navLinks">
            <NavLink href="" Match="NavLinkMatch.All" class="nav-link" @onclick="HandleLinkClick">
                <i class="bi bi-house-door"></i>
                <span>Oversigt</span>
            </NavLink>



            @if (currentUser != null)
            {
                if (currentUser.Role == "Elev")
                {
                    <NavLink href="elevplan" class="nav-link" @onclick="HandleLinkClick">
                        <i class="bi bi-list-ul"></i>
                        <span>Elevplan</span>
                    </NavLink>
                }
                else if (currentUser.Role == "HR" || currentUser.Role == "Køkkenchef" || currentUser.Role == "Kok")
                {
                    <NavLink href="elevplaner" class="nav-link" @onclick="HandleLinkClick">
                        <i class="bi bi-list-ul"></i>
                        <span>Elevplaner</span>
                    </NavLink>
                }
            }

            @if (currentUser != null && currentUser.Role != "Elev")
            {
                <NavLink href="users" class="nav-link" @onclick="HandleLinkClick">
                    <i class="bi bi-people"></i>
                    <span>Brugere</span>
                </NavLink>
            }

            <NavLink href="learningmaterials" class="nav-link" @onclick="HandleLinkClick">
                <i class="bi bi-journal-bookmark"></i>
                <span>Læringsmateriale</span>
            </NavLink>

            <NavLink href="posts" class="nav-link" @onclick="HandleLinkClick">
                <i class="bi bi-card-text"></i>
                <span>Opslagstavle</span>
            </NavLink>

            <NavLink href="quiz" class="nav-link" @onclick="HandleLinkClick">
                <i class="bi bi-patch-question"></i>
                <span>Quiz</span>
            </NavLink>

            @if (currentUser != null && currentUser.Role != "Elev")
            {
                <NavLink href="rapporter" class="nav-link" @onclick="HandleLinkClick">
                    <i class="bi bi-bar-chart"></i>
                    <span>Rapporter</span>
                </NavLink>
            }
        </nav>

        <!-- User Section -->
        <div class="nav-user">
            @if (isLoggedIn && currentUser != null)
            {
                <div class="user-menu" @onclick="ToggleUserMenu">
                    <div class="user-avatar">@GetInitials(currentUser.Name)</div>
                    <div class="user-info-desktop">
                        <div class="user-name">@currentUser.Name</div>
                        <div class="user-role">@currentUser.Role</div>
                    </div>
                    <i class="bi bi-chevron-down user-dropdown-icon @(showUserMenu ? "rotated" : "")"></i>
                </div>
                
                @if (showUserMenu)
                {
                    <div class="user-dropdown">
                        <div class="user-info-mobile">
                            <div class="user-name">@currentUser.Name</div>
                            <div class="user-role">@currentUser.Role</div>
                        </div>
                        <hr class="dropdown-divider"/>
                        <a href="#" @onclick="HandleLogout" class="dropdown-item">
                            <i class="bi bi-box-arrow-right"></i>
                            Log ud
                        </a>
                    </div>
                }
            }
            else
            {
                <NavLink href="/login" class="login-btn" @onclick="HandleLinkClick">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Log ind</span>
                </NavLink>
            }
        </div>

        <!-- Mobile Menu Toggle -->
        <button class="mobile-menu-toggle" @onclick="ToggleMobileMenu" aria-label="Toggle navigation">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
        </button>
    </div>

    <!-- Mobile Navigation Overlay -->
    @if (showMobileMenu)
    {
        <div class="mobile-nav-overlay" @onclick="CloseMobileMenu">
            <div class="mobile-nav-content" @onclick:stopPropagation="true">
                <div class="mobile-nav-header">
                    <div class="mobile-brand">
                        <div class="brand-icon">C</div>
                        <span>Comwell</span>
                    </div>
                    <button class="mobile-close" @onclick="CloseMobileMenu">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <nav class="mobile-nav-links">
                    <NavLink href="" Match="NavLinkMatch.All" class="mobile-nav-link" @onclick="HandleMobileLinkClick">
                        <i class="bi bi-house-door"></i>
                        <span>Oversigt</span>
                    </NavLink>



                    @if (currentUser != null)
                    {
                        if (currentUser.Role == "Elev")
                        {
                            <NavLink href="elevplan" class="mobile-nav-link" @onclick="HandleMobileLinkClick">
                                <i class="bi bi-list-ul"></i>
                                <span>Elevplan</span>
                            </NavLink>
                        }
                        else if (currentUser.Role == "HR" || currentUser.Role == "Køkkenchef" || currentUser.Role == "Kok")
                        {
                            <NavLink href="elevplaner" class="mobile-nav-link" @onclick="HandleMobileLinkClick">
                                <i class="bi bi-list-ul"></i>
                                <span>Elevplaner</span>
                            </NavLink>
                        }
                    }

                    @if (currentUser != null && currentUser.Role != "Elev")
                    {
                        <NavLink href="users" class="mobile-nav-link" @onclick="HandleMobileLinkClick">
                            <i class="bi bi-people"></i>
                            <span>Brugere</span>
                        </NavLink>
                    }

                    <NavLink href="learningmaterials" class="mobile-nav-link" @onclick="HandleMobileLinkClick">
                        <i class="bi bi-journal-bookmark"></i>
                        <span>Læringsmateriale</span>
                    </NavLink>

                    <NavLink href="posts" class="mobile-nav-link" @onclick="HandleMobileLinkClick">
                        <i class="bi bi-card-text"></i>
                        <span>Opslagstavle</span>
                    </NavLink>

                    <NavLink href="quiz" class="mobile-nav-link" @onclick="HandleMobileLinkClick">
                        <i class="bi bi-patch-question"></i>
                        <span>Quiz</span>
                    </NavLink>

                    @if (currentUser != null && currentUser.Role != "Elev")
                    {
                        <NavLink href="rapporter" class="mobile-nav-link" @onclick="HandleMobileLinkClick">
                            <i class="bi bi-bar-chart"></i>
                            <span>Rapporter</span>
                        </NavLink>
                    }
                </nav>

                @if (isLoggedIn && currentUser != null)
                {
                    <div class="mobile-user-section">
                        <div class="mobile-user-info">
                            <div class="user-avatar">@GetInitials(currentUser.Name)</div>
                            <div class="user-details">
                                <div class="user-name">@currentUser.Name</div>
                                <div class="user-role">@currentUser.Role</div>
                            </div>
                        </div>
                        <button class="mobile-logout-btn" @onclick="HandleLogout">
                            <i class="bi bi-box-arrow-right"></i>
                            Log ud
                        </button>
                    </div>
                }
                else
                {
                    <div class="mobile-auth-section">
                        <NavLink href="/login" class="mobile-login-btn" @onclick="HandleMobileLinkClick">
                            <i class="bi bi-box-arrow-in-right"></i>
                            Log ind
                        </NavLink>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback ToggleMenu { get; set; }

    private User? currentUser;
    private bool isLoggedIn = false;
    private bool showMobileMenu = false;
    private bool showUserMenu = false;

    protected override async Task OnInitializedAsync()
    {
        var user = await LocalStorage.GetItemAsync<User>("loggedInUser");
        if (user == null)
        {
            var userJson = await JSRuntime.InvokeAsync<string>("sessionStorageInterop.getItem", "loggedInUser");
            if (!string.IsNullOrEmpty(userJson))
            {
                user = System.Text.Json.JsonSerializer.Deserialize<User>(userJson);
            }
        }
        isLoggedIn = user != null;
        currentUser = user;
    }

    private async Task HandleLogout()
    {
        await LocalStorage.RemoveItemAsync("loggedInUser");
        await JSRuntime.InvokeVoidAsync("sessionStorageInterop.removeItem", "loggedInUser");
        isLoggedIn = false;
        showUserMenu = false;
        showMobileMenu = false;
        NavManager.NavigateTo("/login", true);
        await ToggleMenu.InvokeAsync();
    }

    private async Task HandleLinkClick()
    {
        await ToggleMenu.InvokeAsync();
    }

    private async Task HandleMobileLinkClick()
    {
        showMobileMenu = false;
        await ToggleMenu.InvokeAsync();
    }

    private void ToggleMobileMenu()
    {
        showMobileMenu = !showMobileMenu;
        if (showMobileMenu)
        {
            showUserMenu = false;
        }
    }

    private void CloseMobileMenu()
    {
        showMobileMenu = false;
    }

    private void ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
    }

    private static string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "";
        
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "",
            1 => parts[0][..1].ToUpper(),
            _ => $"{parts[0][..1]}{parts[^1][..1]}".ToUpper()
        };
    }
}
